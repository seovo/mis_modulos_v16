<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Producto -->
<record id="view_datawave_producto_list" model="ir.ui.view">
    <field name="name">datawave.producto.list</field>
    <field name="model">datawave.producto</field>
    <field name="arch" type="xml">
        <list>
            <field name="name"/>
            <field name="description" />
            <field name="categ"/>
            <field name="uom"/>
            <field name="state"/>
        </list>
    </field>
</record>

<record id="view_datawave_producto_form" model="ir.ui.view">
    <field name="name">datawave.producto.form</field>
    <field name="model">datawave.producto</field>
    <field name="arch" type="xml">
        <form>
            <sheet>
                <group>
                    <field name="name"/>
                    <field name="description" />
                    <field name="categ"/>
                    <field name="uom"/>
                    <field name="state"/>
                </group>
            </sheet>
        </form>
    </field>
</record>

    <record id="action_datawave_producto" model="ir.actions.act_window">
       <field name="name">Datawave Producto</field>
       <field name="type">ir.actions.act_window</field>
       <field name="res_model">datawave.producto</field>
       <field name="view_mode">list,form</field>
    </record>


