<?xml version="1.0" encoding="utf-8"?>
<odoo>


<!-- Vistas para datawave.config.cd -->
<record id="view_datawave_config_cd_list" model="ir.ui.view">
    <field name="name">datawave.config.cd.list</field>
    <field name="model">datawave.config.cd</field>
    <field name="arch" type="xml">
        <list>
            <field name="cd_id"/>
            <field name="days_delta"/>
            <field name="fixed_frequency"/>
            <field name="z_cd"/>
            <field name="days_target"/>
            <field name="cicle_review_day"/>
        </list>
    </field>
</record>

<record id="view_datawave_config_cd_form" model="ir.ui.view">
    <field name="name">datawave.config.cd.form</field>
    <field name="model">datawave.config.cd</field>
    <field name="arch" type="xml">
        <form>
            <sheet>
                <group>
                    <field name="cd_id"/>
                    <field name="days_delta"/>
                    <field name="fixed_frequency"/>
                    <field name="z_cd"/>
                    <field name="days_target"/>
                    <field name="cicle_review_day"/>
                </group>
            </sheet>
        </form>
    </field>
</record>

