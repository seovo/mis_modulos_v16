<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- Vistas para datawave.replanish.tienda -->
<record id="view_datawave_replanish_tienda_list" model="ir.ui.view">
    <field name="name">datawave.replanish.tienda.list</field>
    <field name="model">datawave.replanish.tienda</field>
    <field name="arch" type="xml">
        <list>
            <field name="name"/>
            <field name="sku"/>
            <field name="code_tienda"/>
            <field name="quantity_round"/>
            <field name="note"/>
        </list>
    </field>
</record>

<record id="view_datawave_replanish_tienda_form" model="ir.ui.view">
    <field name="name">datawave.replanish.tienda.form</field>
    <field name="model">datawave.replanish.tienda</field>
    <field name="arch" type="xml">
        <form>
            <sheet>
                <group>
                    <field name="name"/>
                    <field name="sku"/>
                    <field name="code_tienda"/>
                    <field name="quantity_round"/>
                    <field name="note"/>
                </group>
            </sheet>
        </form>
    </field>
</record>

