    <field name="model">datawave.stock.cd</field>
    <field name="arch" type="xml">
        <form string="Stock CD">
            <sheet>
                <group>
                    <field name="name"/>
                    <field name="sku"/>
                    <field name="code_cd"/>
                    <field name="stock"/>
                    <field name="date"/>
                    <field name="code_seller"/>
                </group>
            </sheet>
        </form>
        <tree string="Lista de Stock CD">
            <field name="name"/>
            <field name="sku"/>
            <field name="code_cd"/>
            <field name="stock"/>
            <field name="date"/>
            <field name="code_seller"/>
        </tree>
    </field>
</record>

