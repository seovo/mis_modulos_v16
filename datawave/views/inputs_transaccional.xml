<?xml version="1.0" encoding="utf-8"?>
<odoo>


<!-- Vistas Combinadas -->
<record id="view_datawave_stock_tienda" model="ir.ui.view">
    <field name="name">datawave.stock.tienda.view</field>
    <field name="model">datawave.stock.tienda</field>
    <field name="arch" type="xml">
        <form string="Stock Tienda">
            <sheet>
                <group>
                    <field name="name"/>
                    <field name="sku"/>
                    <field name="code_tienda"/>
                    <field name="stock"/>
                    <field name="date"/>
                </group>
            </sheet>
        </form>
        <tree string="Lista de Stock Tienda">
            <field name="name"/>
            <field name="sku"/>
            <field name="code_tienda"/>
            <field name="stock"/>
            <field name="date"/>
        </tree>
    </field>
</record>

<record id="view_datawave_stock_cd" model="ir.ui.view">
