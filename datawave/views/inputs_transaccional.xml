<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- Vistas para datawave.stock.tienda -->
<record id="view_datawave_stock_tienda_list" model="ir.ui.view">
    <field name="name">datawave.stock.tienda.list</field>
    <field name="model">datawave.stock.tienda</field>
    <field name="arch" type="xml">
        <list>
            <field name="name"/>
            <field name="sku"/>
            <field name="code_tienda"/>
            <field name="stock"/>
            <field name="date"/>
        </list>
    </field>
</record>

<record id="view_datawave_stock_tienda_form" model="ir.ui.view">
    <field name="name">datawave.stock.tienda.form</field>
    <field name="model">datawave.stock.tienda</field>
    <field name="arch" type="xml">
        <form>
            <sheet>
                <group>
                    <field name="name"/>
                    <field name="sku"/>
                    <field name="code_tienda"/>
                    <field name="stock"/>
                    <field name="date"/>
                </group>
            </sheet>
        </form>
    </field>
</record>

