<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_intermedio_generador" model="ir.ui.view">
        <field name="name">Generar Intermedios</field>
        <field name="model">intermedio.generador</field>
        <field name="priority">2</field>
        <field name="arch" type="xml">
            <form string="Transfer Data To Server">
                <group>
                    <field name="date" />
                    <field name="date_end" />
                    <field name="table" />


                </group>
                <footer>
                    <button name="generate_table" string="Generar Data"
                            type="object" class="oe_highlight" />

                    <button string="Cancel" class="oe_link" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>


    <record id="action_intermedio_generador" model="ir.actions.act_window">
        <field name="name">Generar Intermedios</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">intermedio.generador</field>
        <field name="view_mode">form</field>
        <!--<field name="view_id" ref="view_vex_synchro"/> -->
        <field name="target">new</field>
    </record>

</odoo>