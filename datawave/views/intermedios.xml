            <field name="stock_forecast" optional="show" />
            <field name="forecast_day" optional="show" />
            <field name="quantity" optional="hidden" />
            <field name="quantity_round" string="Cantidad a Reponer" optional="show" />
            <field name="riesgo" string="Riesgo de Rotura"  optional="show" />
            <field name="sobreestock"  optional="show" />
            <field name="lt_days" optional="show" />
