<?xml version="1.0" encoding="utf-8"?>
<odoo>


<!-- Vistas para datawave.intermedio.tienda -->
<record id="view_datawave_intermedio_tienda_list" model="ir.ui.view">
    <field name="name">datawave.intermedio.tienda.list</field>
    <field name="model">datawave.intermedio.tienda</field>
    <field name="arch" type="xml">
        <list>
            <field name="date"  optional="show" />
            <field name="tienda_id" string="Punto de Venta"  optional="show" />
            <field name="product_id"  optional="show" />
            <field name="product_description"  optional="show" />
            <field name="product_state"  optional="show" />
            <field name="stock"  optional="show" />
            <field name="forecast_day" string="Forecast Diario Pdv"  optional="show" />
            <field name="quantity_round" string="Cantidad a Reponer"  optional="show" />
            <field name="riesgo" string="Riesgo de Rotura"  optional="show" />
            <field name="sobreestock"  optional="show" />
            <field name="lt_days"  optional="show" />
            <field name="freq"  optional="show" />
            <field name="max"  optional="show" />
            <field name="rop"  optional="show" />
            <field name="ss" string="Stock Seguridad" optional="show" />

            <field name="sigma" optional="hidden" />
            <field name="quantity"  optional="hidden" />



        </list>
    </field>
</record>

<record id="view_datawave_intermedio_tienda_form" model="ir.ui.view">
    <field name="name">datawave.intermedio.tienda.form</field>
    <field name="model">datawave.intermedio.tienda</field>
    <field name="arch" type="xml">
        <form>
            <sheet>
                <group>
                    <field name="date" />
                    <field name="product_id" />
                    <field name="product_description" />
                    <field name="product_state" />
                    <field name="tienda_id" />
                    <field name="lt_days"/>
                    <field name="forecast_day"/>
                    <field name="sigma"/>
                    <field name="ss"/>
                    <field name="freq"/>
                    <field name="max"/>
                    <field name="rop"/>
                    <field name="stock"/>
                    <field name="quantity"/>
                    <field name="quantity_round"/>
                    <field name="riesgo" />
                    <field name="sobreestock" />
                    <field name="datawave_sale_ids" />

                </group>
            </sheet>
        </form>
    </field>
</record>

<!-- Vistas para datawave.intermedio.cd -->
