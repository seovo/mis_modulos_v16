<?xml version="1.0" encoding="utf-8"?>
<odoo>

 <!-- Vistas para datawave.sigma.cd -->
<record id="view_datawave_sigma_cd_list" model="ir.ui.view">
    <field name="name">datawave.sigma.cd.list</field>
    <field name="model">datawave.sigma.cd</field>
    <field name="arch" type="xml">
        <list>
            <field name="name"/>
            <field name="sku"/>
            <field name="code_cd"/>
            <field name="sigma"/>
        </list>
    </field>
</record>

<record id="view_datawave_sigma_cd_form" model="ir.ui.view">
    <field name="name">datawave.sigma.cd.form</field>
    <field name="model">datawave.sigma.cd</field>
    <field name="arch" type="xml">
        <form>
            <sheet>
                <group>
                    <field name="name"/>
                    <field name="sku"/>
                    <field name="code_cd"/>
                    <field name="sigma"/>
                </group>
            </sheet>
        </form>
    </field>
</record>

