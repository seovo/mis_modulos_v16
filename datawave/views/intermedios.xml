<?xml version="1.0" encoding="utf-8"?>
<odoo>


<!-- Vistas para datawave.intermedio.tienda -->
<record id="view_datawave_intermedio_tienda_list" model="ir.ui.view">
    <field name="name">datawave.intermedio.tienda.list</field>
    <field name="model">datawave.intermedio.tienda</field>
    <field name="arch" type="xml">
        <list>
            <field name="date" />
            <field name="tienda_id" string="Punto de Venta" />
            <field name="product_id" />
            <field name="product_description" />
            <field name="product_state" />
            <field name="stock" />
            <field name="forecast_day" string="Forecast Diario Pdv" />
            <field name="quantity_round" string="Cantidad a Reponer" />
            <field name="riesgo" string="'Riesgo de Rotura" />
            <field name="sobreestock" />
            <field name="lt_days" />
            <field name="freq" />
            <field name="max" />
            <field name="rop" />
            <field name="ss" string="Stock Seguridad"/>

            <field name="sigma" optional="hidden" />
            <field name="quantity"  optional="hidden" />



        </list>
    </field>
</record>

<record id="view_datawave_intermedio_tienda_form" model="ir.ui.view">
    <field name="name">datawave.intermedio.tienda.form</field>
    <field name="model">datawave.intermedio.tienda</field>
    <field name="arch" type="xml">
        <form>
            <sheet>
                <group>
                    <field name="date"/>
                    <field name="product_id" />
                    <field name="product_description" />
                    <field name="product_state" />
                    <field name="tienda_id" />
                    <field name="lt_days"/>
                    <field name="forecast_day"/>
                    <field name="sigma"/>
                    <field name="ss"/>
                    <field name="freq"/>
                    <field name="max"/>
                    <field name="rop"/>
                    <field name="stock"/>
                    <field name="quantity"/>
                    <field name="quantity_round"/>
                    <field name="riesgo" />
                    <field name="sobreestock" />
                    <field name="datawave_sale_ids" />

                </group>
            </sheet>
        </form>
    </field>
</record>

<!-- Vistas para datawave.intermedio.cd -->
<record id="view_datawave_intermedio_cd_list" model="ir.ui.view">
    <field name="name">datawave.intermedio.cd.list</field>
    <field name="model">datawave.intermedio.cd</field>
    <field name="arch" type="xml">
        <list>
            <field name="date"/>
            <field name="cd_id"/>
            <field name="seller_id"/>
            <field name="product_id"/>
            <field name="product_description" />
            <field name="product_state" />
            <field name="stock"/>
            <field name="stock_transit"/>
            <field name="stock_forecast"/>
            <field name="forecast_day"/>
            <field name="quantity" optional="hidden" />
            <field name="quantity_round" string="Cantidad a Reponer"/>
            <field name="riesgo" string="Riesgo de Rotura" />
            <field name="sobreestock" />
            <field name="lt_days"/>
            <field name="freq"/>
            <field name="max"/>
            <field name="rop"/>
            <field name="ss" string="Stock Seguridad" />
            <field name="moq"/>
            <field name="sigma" optional="hidden" />





        </list>
    </field>
</record>

<record id="view_datawave_intermedio_cd_form" model="ir.ui.view">
    <field name="name">datawave.intermedio.cd.form</field>
    <field name="model">datawave.intermedio.cd</field>
    <field name="arch" type="xml">
        <form>
            <sheet>
                <group>
                    <field name="date"/>
                    <field name="product_id"/>
                    <field name="product_description" />
                    <field name="product_state" />
                    <field name="cd_id"/>
                    <field name="seller_id"/>
                    <field name="lt_days"/>
                    <field name="forecast_day"/>
                    <field name="sigma"/>
                    <field name="moq"/>
                    <field name="stock"/>
                    <field name="stock_transit"/>
                    <field name="stock_forecast"/>
                    <field name="stock_forecast_day"/>
                    <field name="ss"/>
                    <field name="freq"/>
                    <field name="max"/>
                    <field name="rop"/>
                    <field name="quantity"/>
                    <field name="quantity_round"/>
                    <field name="riesgo" />
                    <field name="sobreestock" />
                    <field name="datawave_sale_ids" />
                </group>
            </sheet>
        </form>
    </field>
</record>

<!-- Acciones -->


<record id="action_datawave_intermedio_tienda" model="ir.actions.act_window">
    <field name="name">Intermedio Tienda</field>
    <field name="res_model">datawave.intermedio.tienda</field>
    <field name="view_mode">list,form</field>
</record>

<record id="action_datawave_intermedio_cd" model="ir.actions.act_window">
    <field name="name">Intermedio CD</field>
    <field name="res_model">datawave.intermedio.cd</field>
    <field name="view_mode">list,form</field>
</record>

<!-- Menús -->



</odoo>