    <template id="ubl_20_InvoiceType" inherit_id="account_edi_ubl_cii.ubl_20_InvoiceType" primary="True">
        <xpath expr="//*[local-name()='PaymentTerms']" position="after">
            <t xmlns:cac="urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2"
               xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2">
                <t t-if="vals.get('down_payment', False)">
                    <t t-foreach="vals.get('down_payment')['prepaid']" t-as="line">
                        <cac:PrepaidPayment>
                            <cbc:ID schemeID="02"
                                    schemeName="Anticipo"
                                    schemeAgencyName="PE:SUNAT"
                                    t-esc="line['invoice'].name"/>
                            <cbc:PaidAmount t-att-currencyID="line['invoice'].currency_id.name"
                                            t-esc="format_float(line['invoice'].amount_total)"/>
                        </cac:PrepaidPayment>
                    </t>
                </t>
            </t>
        </xpath>
    </template>
