<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="view_move_form_advance" model="ir.ui.view">
            <field name="name">view.move.form.advance</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">

                <xpath expr="//notebook/page[@name='other_info']/group/group/field[@name='partner_bank_id']" position="after">
                    <field name="advance_product_id" invisible="0"/>
                    <field name="invoice_advance_ids" widget="many2many_tags" domain="[('invoice_line_ids.product_id', '=', advance_product_id),('partner_id', '=', partner_id),('invoice_balance_id', '=', False),('invoice_advance_ids','=',False),('state', '=', 'posted'),('move_type', '=', 'out_invoice'),('edi_state', '=', 'sent')]"/>
                </xpath>

            </field>
        </record>
    </data>
</odoo>
