<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_currency_update_dp" model="ir.cron">
        <field name="name">Currency: rate update dp</field>
        <field name="model_id" ref="base.model_res_company"/>
        <field name="state">code</field>
        <field name="code">model.check_exchange_rate_today()</field>
        <field name="nextcall" eval="(DateTime.now().replace(hour=11, minute=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')" />
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
    </record>
</odoo>