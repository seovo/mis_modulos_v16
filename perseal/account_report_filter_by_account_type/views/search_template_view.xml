
<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="account_report_filter_by_account_type.MulticurrencyRevaluationReportFilterExchangeRate" t-inherit="account_reports.MulticurrencyRevaluationReportFilterExchangeRate" t-inherit-mode="extension">
        <xpath expr="//li[hasclass('dropdown-item')]" position="replace">
            <div class="dropdown-item">
                    <label class="d-flex align-items-center">
                        122 <t t-esc="currencyRate.currency_main"/> <i class="fa fa-arrow-right"/> <t t-esc="currencyRate.currency_name"/>
                    </label>

                    <div>
                        <input
                            type="number"
                            min="0"
                            step="0.000001"
                            t-att-value="currencyRate.rate"
                            t-att-name="currencyRate.currency_id"
                        />
                    </div>

                    <button class="btn btn-sm btn-primary" t-on-click="() => this.filterExchangeRate()">Apply</button>
                </div>
        </xpath>
    </t>

</templates>