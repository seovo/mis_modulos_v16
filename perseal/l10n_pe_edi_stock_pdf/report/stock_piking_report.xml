<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="paperformat_euro_guide_remision" model="report.paperformat">
            <field name="name">A4-Guia de Remison</field>
            <field name="default" eval="True" />
            <field name="format">A4</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">25</field>
            <field name="margin_bottom">32</field>
            <field name="margin_left">7</field>
            <field name="margin_right">7</field>
            <field name="header_line" eval="False" />
            <field name="header_spacing">20</field>
            <field name="dpi">90</field>
        </record>

        <record id="action_report_picking_guide_pdf" model="ir.actions.report">
            <field name="name">Guia PDF</field>
            <field name="model">stock.picking</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">l10n_pe_edi_stock_pdf.report_picking_guide_template</field>
            <field name="report_file">l10n_pe_edi_stock_pdf.report_picking_guide_template</field>
            <field name="print_report_name">((object.l10n_latam_document_number or object.name).replace('/','')+'.pdf')</field>
            <field name="binding_model_id" ref="stock.model_stock_picking"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="l10n_pe_edi_stock_pdf.paperformat_euro_guide_remision"/>
        </record>

    </data>
</odoo>