<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="picking_guide_barcode" inherit_id="l10n_pe_edi_stock_pdf.picking_guide">
        <xpath expr="//t/t/div[@name='product_list']/table/thead/tr" position="replace">
            <tr>
                <td style="width: 10%"/>
                <td style="width: 16%"/>
                <td style="width: 50%"/>
                <td style="width: 14%"/>
                <td style="width: 10%"/>
            </tr>
        </xpath>

        <xpath expr="//t/t/div[@name='product_list']/table/thead/tr[2]/th" position="after">
            <th><strong>BARCODE</strong></th>
        </xpath>
        <xpath expr="//t/t/div[@name='product_list']/table/tbody/t" position="replace">
            <t t-set="has_serial_number" t-value="False"/>
            <t t-set="has_serial_number" t-value="o.move_line_ids.mapped('lot_id')"/>

            <t t-set="product_list" t-value="o.move_line_ids.mapped('product_id')"/>

            <t t-foreach="product_list" t-as="product">
                <tr t-foreach="o.move_line_ids.filtered(lambda l: l.product_id == product)" t-as="move_line" class="text-center">
                    <td style="padding-top:8px; padding-bottom:8px">
                        <span t-field="move_line.product_id.default_code"/>
                    </td>
                    <t t-if="has_serial_number" name="move_line_lot">
                        <td><span t-field="move_line.lot_id.name"/></td>
                    </t>
                    <td>
                        <span t-field="move_line.product_id.name"/>

                    </td>

                    <td class="text-center" name="move_line_lot_quantity">
                        <span t-field="move_line.quantity"/>

                        <span t-if="move_line.move_id.product_packaging_id" groups="product.group_stock_packaging">
                            (<span t-field="move_line.product_packaging_qty" t-options='{"widget": "integer"}'/> <span t-field="move_line.move_id.product_packaging_id.display_name"/>)
                        </span>
                    </td>
                    <td>
                        <span t-field="move_line.product_id.uom_id.name"/>
                    </td>
                </tr>
            </t>



        </xpath>
    </template>
</odoo>