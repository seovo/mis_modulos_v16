<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_move_form" model="ir.ui.view">
            <field name="name">account.move.form</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">

                <field name="invoice_date" position="after">
                    <field name="count_invoice_cred" invisible="1"/>
                </field>

                <xpath expr="//notebook/page[last()]" position="after">
                    <page string="Cuotas" invisible="count_invoice_cred == False">
                        <field name="invoice_cred" readonly="l10n_pe_edi_refund_reason != '13' or state != 'draft'">
                            <tree string="Products" editable="bottom">
                                <field name="number_due"/>
                                <field name="amount_due" sum="Total"/>
                                <field name="amount_net"/>
                                <field name="expiration_date"/>
                                <field name="currency_credit"/>
                            </tree>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>





