<odoo>
    <data>
        <!-- Inherit Form View to Modify it -->
        <record id="view_account_analytic_account_form_mirror" model="ir.ui.view">
            <field name="name">view.account.analytic.account.form.mirror</field>
            <field name="model">account.analytic.account</field>
            <field name="inherit_id" ref="analytic.view_account_analytic_account_form"/>
            <field name="priority" eval="1"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='code']" position="after">
                    <field name="account_credit_id" domain="[('internal_group', 'in', ['income', 'expense'])]"/>
                </xpath>
                <xpath expr="//field[@name='currency_id']" position="after">
                    <field name="account_debit_id" domain="[('internal_group', 'in', ['income', 'expense'])]"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>