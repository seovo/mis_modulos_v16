<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <template id="report_invoice_document_credit_payments_inherit_l10n_pe_agent_retention"  inherit_id="l10n_pe_credit_payments_pdf.report_invoice_document_credit_payments">
        <xpath expr="//table[@t-if='o.invoice_cred']" position="after">
            <div>
                <t t-set="retention" t-value="o._prepare_retention()"/>
                <table t-if="retention" class="table text-left tbl_amount_detail">
                    <th colspan="6">
                        <strong>
                            INFORMACIÓN DE RETENCIÓN
                        </strong>
                    </th>
                    <tr>
                        <td><span><strong>Base imponible:</strong></span></td>
                        <td><span><t t-esc="retention['BaseAmount']" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></span></td>
                        <td><span><strong>Porcentaje:</strong></span></td>
                        <td><span><t t-esc="retention['MultiplierFactorNumeric'] * 100"/>%</span></td>
                        <td><span><strong>Monto:</strong></span></td>
                        <td><span><t t-esc="retention['Amount']" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></span></td>
                    </tr>
                </table>
            </div>
        </xpath>
    </template>

    <template id="report_invoice_document_credit_payments_inherit_l10n_pe_agent_retention_imherit_l10n_pe_agent_retention_payments_pdf"  inherit_id="l10n_pe_agent_retention_pdf.report_invoice_document_credit_payments_inherit_l10n_pe_agent_retention">
        <xpath expr="//div[@id='retention']" position="replace"/>
    </template>

</odoo>