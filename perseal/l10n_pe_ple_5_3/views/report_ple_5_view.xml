<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_report_ple_05_3_tree" model="ir.ui.view">
            <field name="name">report.ple.05.3.tree</field>
            <field name="model">report.ple.05.3</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="company_id"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="indicator_operation"/>
                    <field name="indicator_content"/>
                    <field name="currency_id"/>
                    <field name="state"/>
                    <field name="create_uid" string="Creado por"/>
                    <field name="create_date" string="Fecha creación"/>
                </tree>
            </field>
        </record>
        <record id="view_report_ple_05_3_form" model="ir.ui.view">
            <field name="name">report.ple.05.3.form</field>
            <field name="model">report.ple.05.3</field>
            <field name="arch" type="xml">
                <form duplicate="0">
                    <header>
                        <button name="action_generate" string="Generar" type="object" class="oe_highlight" states="draft,validated"/>
                        <button name="action_declare" string="Declarar" type="object" class="oe_highlight" states="validated"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div style="width: 70%;">
                            <table>
                                <tr>
                                    <td><label for="company_id"/></td>
                                    <td style="padding-left: 20px;"><field name="company_id" style="width: 100%;" options="{'no_create': True, 'no_create_edit':True, 'no_quick_create': True, 'no_open': True}"/></td>
                                </tr>
                                <tr>
                                    <td><label for="date_from"/></td>
                                    <td style="padding-left: 20px;"><field name="date_from" style="width: 100%;"/></td>
                                </tr>
                                <tr>
                                    <td><label for="date_to"/></td>
                                    <td style="padding-left: 20px;"><field name="date_to" style="width: 100%;"/></td>
                                </tr>
                                 <tr>
                                    <td><label for="indicator_operation"/></td>
                                    <td style="padding-left: 20px;"><field name="indicator_operation" style="width: 100%;"/></td>
                                </tr>
                                 <tr>
                                    <td><label for="indicator_content"/></td>
                                    <td style="padding-left: 20px;"><field name="indicator_content" style="width: 100%;"/></td>
                                </tr>
                                <tr invisible="True">
                                    <td><label for="type_report"/></td>
                                    <td style="padding-left: 20px;"><field name="type_report"/></td>
                                </tr>
                                 <tr>
                                    <td><label for="currency_id"/></td>
                                    <td style="padding-left: 20px;"><field name="currency_id" style="width: 100%;" options="{'no_create': True, 'no_create_edit':True, 'no_quick_create': True, 'no_open': True}"/></td>
                                </tr>
                                <tr>
                                    <td><label for="state_opportunity"/></td>
                                    <td style="padding-left: 20px;"><field name="state_opportunity" style="width: 100%;"/></td>
                                </tr>
                                <tr  attrs="{'invisible': [('type_report', 'not in', 'normal')]}">
                                    <td><label for="file_txt"/></td>
                                    <td style="padding-left: 20px;">
                                        <field name="filename_txt" invisible="True"/>
                                        <field name="file_txt" filename="filename_txt" widget="binary"/>
                                    </td>
                                </tr>

                            </table>
                        </div>
                        <notebook>
                            <page string="Detalle">
                                <field name="line_ids">
                                    <tree>
                                        <field name="period"/>
                                        <field name="codigo_cuenta_desagregado"/>
                                        <field name="descripcion_cuenta_desagregado"/>
                                        <field name="codigo_cuenta_tributario"/>
                                        <field name="descripcion_cuenta_tributario"/>
                                        <field name="codigo_cuenta_corporativa"/>
                                        <field name="descripcion_cuenta_corporativa"/>
                                        <field name="state_opportunity"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>
        <!-- Sequences-->
        <record model="ir.sequence" id="sequence_report_ple_05_3">
            <field name="name">Libro diario</field>
            <field name="code">report.ple.05.3</field>
            <field name="prefix">RC-</field>
            <field name="padding">6</field>
        </record>

    <record id="action_report_ple_5_3" model="ir.actions.act_window">
        <field name="name">Libro diario - Plan contable utilizado</field>
        <field name="res_model">report.ple.05.3</field>
        <field name="view_mode">tree,form</field>
     </record>

    <menuitem id="menu_report_ple_5_3"
              name="Libro diario - Plan contable utilizado"
              parent="l10n_pe_ple.menu_report_ple"
              sequence="20"
              action="action_report_ple_5_3"/>
    </data>
</odoo>