<odoo>
    <data>
        <record id="payment_provider_micuentawebmulti" model="payment.provider">
            <field name="name"><![CDATA[Izipay - Payment in installments]]></field>
            <field name="display_as">Payment by credit card in installments</field>
            <field name="payment_icon_ids"
                eval="[(6, 0, [
                    ref('payment_micuentaweb.payment_icon_cc_micuentawebcb'),
                    ref('payment_micuentaweb.payment_icon_cc_micuentawebvisa'),
                    ref('payment_micuentaweb.payment_icon_cc_micuentawebmastercard'),
                ])]"/>
            <field name="image" type="base64" file="payment_micuentaweb/static/src/img/logo.png" />
            <field name="image_128" type="base64" file="payment_micuentaweb/static/src/img/logo.png" />
            <field name="code">micuentawebmulti</field>
            <field name="state">test</field>
            <field name="company_id" ref="base.main_company" />
            <field name="redirect_form_view_id" ref="micuentaweb_provider_button" />
            <field name="environment">test</field>
            <field name="pre_msg"><![CDATA[<p>You will be redirected to the Izipay website after clicking on the payment button.</p>]]></field>

            <field name="micuentaweb_capture_delay"></field>
            <field name="micuentaweb_validation_mode">-1</field>
            <field name="micuentaweb_threeds_min_amount"></field>
            <field name="micuentaweb_multi_count">3</field>
            <field name="micuentaweb_multi_period">30</field>
            <field name="micuentaweb_multi_first"></field>
            <field name="micuentaweb_redirect_enabled">0</field>
            <field name="micuentaweb_redirect_success_timeout">5</field>
            <field name="micuentaweb_redirect_error_timeout">5</field>
            <field name="micuentaweb_return_mode">GET</field>
        </record>

        <record id="payment_method_micuentawebmulti" model="account.payment.method">
            <field name="name"><![CDATA[Izipay Multi]]></field>
            <field name="code">micuentawebmulti</field>
            <field name="payment_type">inbound</field>
        </record>



    </data>
</odoo>