<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <template id="sunat_guiaremision_inherit_guia_shipping_weight" inherit_id="l10n_pe_edi_stock.sunat_guiaremision">
        <xpath expr="//*[name()='cbc:GrossWeightMeasure']" position="replace">
            <t xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2">
                <cbc:GrossWeightMeasure t-att-unitCode="weight_uom.l10n_pe_edi_measure_unit_code"><t t-esc='format_float(record.shipping_weight if record.shipping_weight else record.weight, 3)'/></cbc:GrossWeightMeasure>
            </t>
        </xpath>
    </template>

</odoo>