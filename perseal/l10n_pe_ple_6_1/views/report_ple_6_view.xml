<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_report_ple_06_tree" model="ir.ui.view">
            <field name="name">report.ple.06.1.tree</field>
            <field name="model">report.ple.06.1</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="company_id"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="indicator_operation"/>
                    <field name="indicator_content"/>
                    <field name="currency_id"/>
                    <field name="state"/>
                    <field name="create_uid" string="Creado por"/>
                    <field name="create_date" string="Fecha creación"/>
                    <button name="action_generate" string="Generar" type="object" groups="base.group_no_one"/>
                </tree>
            </field>
        </record>
        <record id="view_report_ple_06_form" model="ir.ui.view">
            <field name="name">report.ple.06.1.form</field>
            <field name="model">report.ple.06.1</field>
            <field name="arch" type="xml">
                <form duplicate="0">
                    <header>
                        <button name="action_generate" string="Generar" type="object" class="oe_highlight" states="draft,validated"/>
                        <button name="action_declare" string="Declarar" type="object" class="oe_highlight" states="validated"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div style="width: 70%;">
                            <table>
                                <tr>
                                    <td><label for="company_id"/></td>
                                    <td style="padding-left: 20px;"><field name="company_id" style="width: 100%;" options="{'no_create': True, 'no_create_edit':True, 'no_quick_create': True, 'no_open': True}"/></td>
                                </tr>
                                <tr>
                                    <td><label for="date_from"/></td>
                                    <td style="padding-left: 20px;"><field name="date_from" style="width: 100%;"/></td>
                                </tr>
                                <tr>
                                    <td><label for="date_to"/></td>
                                    <td style="padding-left: 20px;"><field name="date_to" style="width: 100%;"/></td>
                                </tr>
                                 <tr>
                                    <td><label for="indicator_operation"/></td>
                                    <td style="padding-left: 20px;"><field name="indicator_operation" style="width: 100%;"/></td>
                                </tr>
                                 <tr>
                                    <td><label for="indicator_content"/></td>
                                    <td style="padding-left: 20px;"><field name="indicator_content" style="width: 100%;"/></td>
                                </tr>
                                <tr invisible="True">
                                    <td><label for="type_report"/></td>
                                    <td style="padding-left: 20px;"><field name="type_report"/></td>
                                </tr>
                                 <tr>
                                    <td><label for="currency_id"/></td>
                                    <td style="padding-left: 20px;"><field name="currency_id" style="width: 100%;" options="{'no_create': True, 'no_create_edit':True, 'no_quick_create': True, 'no_open': True}"/></td>
                                </tr>
                                <tr  attrs="{'invisible': [('type_report', 'not in', 'normal')]}">
                                    <td><label for="file_txt"/></td>
                                    <td style="padding-left: 20px;">
                                        <field name="filename_txt" invisible="True"/>
                                        <field name="file_txt" filename="filename_txt" widget="binary"/>
                                    </td>
                                </tr>

                            </table>
                        </div>
                        <notebook>
                            <page string="Detalle">
                                <field name="line_ids">
                                    <tree>

                                        <field name="move_name"/>
                                        <field name="codigo_cuenta_desagregado_id"/>
                                        <field name="codigo_cuenta_desagregado"/>
                                        <field name="codigo_unidad_operacion"/>
                                        <field name="codigo_centro_costos"/>
                                        <field name="tipo_moneda_origen"/>
                                        <field name="tipo_doc_iden_emisor"/>
                                        <field name="num_doc_iden_emisor"/>
                                        <field name="tipo_comprobante_pago"/>
                                        <field name="num_serie_comprobante_pago"/>
                                        <field name="num_comprobante_pago"/>
                                        <field name="fecha_contable"/>
                                        <field name="fecha_vencimiento"/>
                                        <field name="fecha_operacion"/>
                                        <field name="glosa"/>
                                        <field name="glosa_referencial"/>
                                        <field name="movimientos_debe"/>
                                        <field name="movimientos_haber"/>
                                        <field name="dato_estructurado"/>
                                        <field name="state_opportunity"/>

                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>
        <!-- Sequences-->
        <record model="ir.sequence" id="sequence_report_ple_06">
            <field name="name">Libro mayor</field>
            <field name="code">report.ple.06</field>
            <field name="prefix">RC-</field>
            <field name="padding">6</field>
        </record>

        <!-- Reports XLS-->


		<!--<report  id="report_ple__08"
                 model="report.ple.08"
                 string="Libro compras(Excel)"
                 report_type="xlsx"
                 name="ple.08" file="Libro compras"
                 attachment_use="False"/>-->


        <record id="report_ple__06" model="ir.actions.report">
            <field name="name">Report Excel</field>
            <field name="model">report.ple.06.1</field>
            <field name="report_type">xlsx</field>
            <field name="report_name">report.ple.06.1</field>
            <field name="report_file">report.ple.06.1</field>
            <field name="binding_model_id" ref="model_report_ple_06_1"></field>
            <field name="binding_type">report</field>
        </record>

        <record id="action_report_ple_6" model="ir.actions.act_window">
            <field name="name">Registo Mayor</field>
            <field name="res_model">report.ple.06.1</field>
            <field name="view_mode">tree,form</field>
         </record>

    <menuitem id="menu_report_ple_6" name="Registro Mayor" parent="l10n_pe_ple.menu_report_ple" sequence="21" action="action_report_ple_6"/>

    </data>
</odoo>