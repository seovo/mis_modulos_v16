<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="view_account_payment_register_form" model="ir.ui.view">
        <field name="name">view.account.payment.register.form</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml">
            <field name="group_payment" position="after">
                <field name="is_detraction_pay" invisible="context.get('show_detraction', True)"/>
            </field>
            <field name="communication" position="after">
                <field name="detraction_operation_number" invisible="is_detraction_pay == False" required="is_detraction_pay == True"/>
                <field name="detraction_operation_date" invisible="is_detraction_pay == False" required="is_detraction_pay == True"/>
            </field>
        </field>
    </record>

</odoo>
