<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_move_form_retention" model="ir.ui.view">
            <field name="name">account.move.form.detraction</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">

                <field name="narration" position="after">
                    <field name="retention_show" invisible="1"/>
                    <label for="retention_percentage" invisible="retention_show == False"/>
                    <div name="retention_percentage" invisible="retention_show == False">
                        <field name="retention_percentage" class="oe_inline" invisible="retention_show == False" readonly="1" force_save="1"/> %
                    </div>
                    <field name="retention_amount"
                           invisible="retention_show == False"
                           widget="monetary"
                           options="{'currency_field': 'currency_id'}"
                           readonly="1"
                           force_save="1"/>
                </field>

                <xpath expr="//label[@for='l10n_pe_edi_operation_type']" position="attributes">
                    <attribute name="invisible">move_type == 'entry'</attribute>
                </xpath>

                <field name="l10n_pe_edi_operation_type" position="attributes">
                    <attribute name="invisible">move_type == 'entry'</attribute>
                </field>

            </field>
        </record>

    </data>

</odoo>