    <record id="hr_salary_rule_gtfct" model="hr.salary.rule">
        <field name="category_id" ref="hr_payroll.NET"/>
        <field name="name">Gratificacion a Pagar</field>
        <field name="code">GTFCCAP</field>
        <field name="sequence">110</field>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = (result_rules['RC']['total']/180) * result_rules['DAP']['quantity']
        </field>
