        <field name="code">BGTFCC</field>
        <field name="sequence">120</field>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
if employee.input_eps in ['yes']:
    result = result_rules['GTFCCAP']['total'] * 0.0675
else:
    result = result_rules['GTFCCAP']['total'] * 0.09
        </field>
