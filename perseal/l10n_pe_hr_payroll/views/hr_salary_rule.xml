<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_salary_rule_view_form_pe" model="ir.ui.view">
        <field name="name">hr.salary.rule.form.inherit.pe</field>
        <field name="model">hr.salary.rule</field>
        <field name="inherit_id" ref="hr_payroll.hr_salary_rule_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='description']" position="after">
                <page string="PE" name="l10n_pe">
                    <group colspan="4">
                        <field name="regular" />
                        <field name="sctr"/>
                        <field name="onp"/>
                        <field name="afp"/>
                        <field name="fifth"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>