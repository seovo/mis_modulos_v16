<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payroll_hr_work_entry_type_view_form_inherit_pe" model="ir.ui.view">
        <field name="name">payroll.hr.work.entry.type.view.form.inherit.pe</field>
        <field name="model">hr.work.entry.type</field>
        <field name="inherit_id" ref="hr_work_entry.hr_work_entry_type_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='main_group']" position="after">
                <group>

                    <group string="Horas extra">
                        <field name="extra_hours"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

</odoo>