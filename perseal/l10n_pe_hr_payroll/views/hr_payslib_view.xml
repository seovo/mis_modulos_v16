<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_payslip_view_form_pe" model="ir.ui.view">
        <field name="name">hr.payslip.view.form.pe</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_print_payslip']" position="after">
                <button string="BOLETA DE PAGO" name="action_print_payment" type="object" class="oe_highlight"/>
                <button string="BOLETA CTS" name="action_print_payment_cts" type="object" class="oe_highlight"/>
            </xpath>
        </field>
    </record>
</odoo>