<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_form_inherit_l10n_pe_edi" model="ir.ui.view">
        <field name="name">res.config.settings.form.inherit.l10n.pe.edi</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='invoicing_peruvian_settings']" position="inside">
                <setting help="Ruta y token Nubefact" invisible="l10n_pe_edi_provider != 'nubefact'">
                    <div class="content-group">
                        <div class="row mt32">
                            <label for="l10n_pe_edi_provider_url" class="col-md-5 o_light_label"/>
                            <field name="l10n_pe_edi_provider_url"/>
                            <label for="l10n_pe_edi_provider_token" class="col-md-5 o_light_label"/>
                            <field name="l10n_pe_edi_provider_token" password="True"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>