<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="base_res_config_settings_view_form_inherit_anka_custom" model="ir.ui.view">
        <field name="name">base.res.config.settings.view.form.inherit.anka.custom</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="10"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app notApp="0" string="Operaciones" data-string="Operaciones" name="operaciones">
                    <block title="Contactos">
                        <setting string="Etiquetas de perfiles" help="Establece las etiquetas que serán usadas para determinar el perfil del partner">
                            <div class="content-group">
                                <div class="mt16">
                                    <label for="company_partner_category_cedente_id" class="o_light_label mr16"/>
                                    <field name="company_partner_category_cedente_id"
                                           options="{'no_open': True, 'no_create': True}"
                                           class="oe_inline"/>
                                    <span class="fa fa-lg fa-building-o p-2"
                                          title="Values set here are company-specific."
                                          groups="base.group_multi_company"/>
                                </div>
                                <div class="mt16">
                                    <label for="company_partner_category_deudor_id" class="o_light_label mr16"/>
                                    <field name="company_partner_category_deudor_id"
                                           options="{'no_open': True, 'no_create': True}"
                                           class="oe_inline"/>
                                    <span class="fa fa-lg fa-building-o p-2"
                                          title="Values set here are company-specific."
                                          groups="base.group_multi_company"/>
                                </div>
                                <div class="mt16">
                                    <label for="company_partner_category_proveedor_id" class="o_light_label mr16"/>
                                    <field name="company_partner_category_proveedor_id"
                                           options="{'no_open': True, 'no_create': True}"
                                           class="oe_inline"/>
                                    <span class="fa fa-lg fa-building-o p-2"
                                          title="Values set here are company-specific."
                                          groups="base.group_multi_company"/>
                                </div>
                                <div class="mt16">
                                    <label for="company_partner_category_beneficiario_id" class="o_light_label mr16"/>
                                    <field name="company_partner_category_beneficiario_id"
                                           options="{'no_open': True, 'no_create': True}"
                                           class="oe_inline"/>
                                    <span class="fa fa-lg fa-building-o p-2"
                                          title="Values set here are company-specific."
                                          groups="base.group_multi_company"/>
                                </div>
                                <div class="mt16">
                                    <label for="company_partner_category_titular_id" class="o_light_label mr16"/>
                                    <field name="company_partner_category_titular_id"
                                           options="{'no_open': True, 'no_create': True}"
                                           class="oe_inline"/>
                                    <span class="fa fa-lg fa-building-o p-2"
                                          title="Values set here are company-specific."
                                          groups="base.group_multi_company"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>