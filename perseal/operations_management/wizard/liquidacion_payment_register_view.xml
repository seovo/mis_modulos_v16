<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="liquidacion_account_payment_form_view" model="ir.ui.view">
            <field name="name">liquidacion.account.payment.form.view</field>
            <field name="model">liquidacion.payment.register</field>
            <field name="arch" type="xml">
                <form string="Register Payment">
                    <group>
                        <group >
                            <field name="journal_id"
                                   options="{'no_open': True, 'no_create': True}"
                                   domain="[('type', 'in', ['cash', 'bank'])]"
                                   required="1"/>
                            <field name="payment_method_line_id"
                                   required="1"
                                   domain="[('journal_id', '=', journal_id)]"
                                   invisible="journal_id == False"
                                   options="{'no_create': True, 'no_open': True}"/>

                            <field name="partner_bank_id"/>

                        </group>
                        <group >
                           <label for="amount"/>
                            <div name="amount_div" class="o_row">
                                <field name="amount"/>
                                <field name="currency_id"
                                       required="1"
                                       options="{'no_create': True, 'no_open': True}"/>
                            </div>
                            <field name="payment_date"/>
                            <field name="communication"/>
                        </group>
                    </group>
                    <footer>
                        <button string="Create Payment" name="action_create_payment" type="object" class="oe_highlight" data-hotkey="q"/>
                        <button string="Discard" class="btn btn-secondary" special="cancel" data-hotkey="x"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>