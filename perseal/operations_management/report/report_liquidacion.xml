<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <template id="report_operacion_liquidacion">
    <t t-call="web.html_container">
    <t t-foreach="docs" t-as="o">
        <t t-call="web.external_layout">
            <style>
                .white {
                background-color: white;
                font-weight: normal;
                }
            </style>
            <div class="page">

                <table class="table" style="width:100%;padding:5px;">
                 <tr style="visibility: hidden;">
                    <td style="width: 9%"/>
                    <td style="width: 9%"/>
                    <td style="width: 9%"/>
                    <td style="width: 9%"/>
                    <td style="width: 9%"/>
                    <td style="width: 9%"/>
                    <td style="width: 9%"/>
                    <td style="width: 9%"/>
                    <td style="width: 9%"/>
                    <td style="width: 9%"/>
                    <td style="width: 9%"/>
                </tr>
                <tr>
                    <td colspan="2"><strong>N°</strong></td>
                    <td colspan="2"><strong>35</strong></td>
                    <td colspan="7"></td>
                </tr>
                <tr>
                    <td colspan="2">Fecha de emisión:</td>
                    <td colspan="2"></td>
                    <td colspan="7"></td>
                </tr>
                <tr>
                    <td colspan="2">Moneda:</td>
                    <td colspan="2">Dólares</td>
                    <td colspan="7"></td>
                </tr>
        
                <tr>
                    <td colspan="4"><strong>Datos del cliente</strong></td>
     
                    <td colspan="4"><strong>Datos del Adquiriente</strong></td>
        
                    <td colspan="3" rowspan="2" class="white">
                        Moneda: Dólares<br/>
                        TEM: 1.6%<br/>
                        Financiamiento: 99%<br/>
                        Garantía: 1%<br/>
                        Correo: info@kumpafactoring.com
                    </td>
                </tr>
                <tr>
                   
                    <td colspan="2">
                    Nombre de la empresa:<br/>
                    RUC:
                    </td>
                    
                    <td colspan="2">
                    <t t-esc="data['cedente']['name']"/><br/>
                    <t t-esc="data['cedente']['ruc']"/>
                    </td>
                    <td colspan="2">
                    Nombre de la empresa:<br/>
                    RUC:
                    </td>
                    
                    <td colspan="2" class="white">
                    <t t-esc="data['proveedor']['name']"/><br/>
                    <t t-esc="data['proveedor']['ruc']"/>
                    </td>
                    
                </tr>
                </table>

                <!-- Detalle de documentos -->
                <table class="table table-bordered" style="width:100%; margin-top:10px;">
                    <thead>
                        <tr>
                            <th>ITEM</th>
                            <th>DOCUMENTO</th>
                            <th>Valor Nominal</th>
                            <th>Fecha Desembolso</th>
                            <th>Fecha Vencimiento</th>
                            <th>Días Financiamiento</th>
                            <th>Importe Garantía</th>
                            <th>Valor Negociable</th>
                            <th>Interés Descuento</th>
                            <th>Importe Valorizado</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="data['lines']" t-as="line" t-index="idx">
                            <tr>
                                <td><t t-esc="line['item']"/></td>
                                <td><t t-esc="line['documento']"/></td>
                                <td><t t-esc="line['valor_nominal']"/></td>
                                <td><t t-esc="line['fecha_desembolso']"/></td>
                                <td><t t-esc="line['fecha_vencimiento']"/></td>
                                <td><t t-esc="line['dias_financiamiento']"/></td>
                                <td><t t-esc="line['importe_garantia']"/></td>
                                <td><t t-esc="line['valor_negociable']"/></td>
                                <td><t t-esc="line['interes_descuento']"/></td>
                                <td><t t-esc="line['importe_valorizado']"/></td>
                            </tr>
                        </t>
         
                        <tr>
                            <td colspan="9">Costo por estructuración</td>
                            <td>1,116.56</td>
                        </tr>
                        <tr>
                            <td colspan="2"><strong>TOTAL</strong></td>
                            <td><strong><t t-esc="data['totals']['valor_nominal']"/></strong></td>
                            <td colspan="3"></td>
                            <td><strong><t t-esc="data['totals']['importe_garantia']"/></strong></td>
                            <td><strong><t t-esc="data['totals']['valor_negociable']"/></strong></td>
                            <td><strong><t t-esc="data['totals']['interes_descuento']"/></strong></td>
                            <td><strong><t t-esc="data['totals']['importe_valorizado']"/></strong></td>
                        </tr>
                    </tbody>
                </table>

                <!-- Firmas -->
                <div style="margin-top:40px; text-align:center;">
                    <div class="row">
                        <div class="col-3 offset-2" style="border-top:1px solid black">
                            <strong>LA CEDENTE</strong><br/>
                            <t t-esc="data['cedente']"/>
                        </div>
                        <div class="col-3 offset-2" style="border-top:1px solid black">
                            <strong>EL FACTOR</strong><br/>
                            <t t-esc="data['deudor']"/>
                        </div>
                    </div>
                </div>

            </div>
            </t>
        </t>
    </t>
    </template>
</odoo>