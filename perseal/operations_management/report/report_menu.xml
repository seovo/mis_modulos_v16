<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="paperformat_liquidacion" model="report.paperformat">
            <field name="name">A4-Liquidacion</field>
            <field name="default" eval="True" />
            <field name="format">A4</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Landscape</field>
            <field name="margin_top">30</field>
            <field name="margin_bottom">20</field>
            <field name="margin_left">7</field>
            <field name="margin_right">7</field>
            <field name="header_line" eval="False" />
            <field name="header_spacing">20</field>
            <field name="dpi">90</field>
        </record>


        <record id="action_report_operacion_liquidacion_pdf" model="ir.actions.report">
            <field name="name">Liquidacion</field>
            <field name="model">operacion.liquidacion</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">operations_management.report_operacion_liquidacion</field>
            <field name="report_file">operations_management.report_operacion_liquidacion</field>
            <field name="binding_model_id" ref="model_operacion_liquidacion"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="paperformat_liquidacion"/>
        </record>
    </data>
</odoo>