                <td class="text-bold">Soles</td>
                <td>193-25758490-74</td>
                <td>002-193-002575849074-19</td>
            </tr>
            <tr class="table-grey-tr" >
                <td class="text-bold">BBVA</td>
                <td class="text-bold">Soles</td>
                <td>0011-03720100010287-09</td>
                <td>011-372-000100010287-09</td>
            </tr>
            <tr class="table-white-tr" >
                <td class="text-bold">BCP</td>
                <td class="text-bold">Dolares</td>
                <td>193-25938511-23</td>
                <td>002-193002593851123-12</td>
            </tr>
            <tr class="table-grey-tr" >
                <td class="text-bold">BBVA</td>
                <td class="text-bold">Dolares</td>
                <td>0011-03720100025268-02</td>
                <td>011-372-000100025268-02</td>
            </tr>
        </table>
    </template>

    <template id="term_and_condition">
        <div class="text-term" style="page-break-inside: avoid;">
            <t t-set="term_and_condition" t-value="doc.note" />
            <span t-out="term_and_condition" style="page-break-inside: avoid;"/>
            <img src="/sale_order_pdf/static/src/img/pasion.png"
                 style="max-height: 35px;margin-left:100px;margin-top:150px;"/>
        </div>
    </template>

