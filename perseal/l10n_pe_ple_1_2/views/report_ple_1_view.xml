    <record id="action_report_ple_01_2" model="ir.actions.act_window">
        <field name="name">Libro caja y banco - banco</field>
        <field name="res_model">report.ple.01.2</field>
        <field name="view_mode">tree,form</field>
     </record>

    <menuitem id="menu_report_ple_01_2"
              name="Libro caja y banco - banco"
              parent="l10n_pe_ple.menu_report_ple"
              sequence="20"
