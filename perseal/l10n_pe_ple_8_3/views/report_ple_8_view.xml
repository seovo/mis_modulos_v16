        <record id="action_report_ple_8_3" model="ir.actions.act_window">
            <field name="name">Registo de Compras simplificado</field>
            <field name="res_model">report.ple.08.3</field>
            <field name="view_mode">tree,form</field>
         </record>

    <menuitem id="menu_report_ple_8_3"
              name="Registro de Compras simplificado"
              parent="l10n_pe_ple.menu_report_ple"
              sequence="17"
              action="action_report_ple_8_3"/>

    </data>
</odoo>