<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <template id="external_layout_l10n_pe">
        <div class="header o_boxed_header report_header">
            <t t-call="account_invoice_pdf.l10n_pe_report_data_header"/>
        </div>
        <div class="article o_report_layout_boxed"  t-att-data-oe-model="o and o._name"
             t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
            <t t-if="doc_model == 'account.move'">
                <t t-call="account_invoice_pdf.l10n_pe_report_data_invoicing_content"/>
            </t>

        </div>
        <div class="footer o_boxed_footer report_footer">
            <t t-call="account_invoice_pdf.l10n_report_data_footer"/>
        </div>
    </template>

    <template id="l10n_pe_external_layout">
        <t t-if="not o and doc">
            <t t-set="o" t-value="doc"/>
        </t>
        <t t-if="o and 'company_id' in o">
            <t t-set="company" t-value="o.company_id.sudo()"/>
        </t>
        <t t-if="not o or not 'company_id' in o">
            <t t-set="company" t-value="res_company"/>
        </t>
        <t t-call="account_invoice_pdf.external_layout_l10n_pe">
            <t t-raw="0"/>
        </t>
    </template>

    <template id="l10n_pe_report_invoice">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="account_invoice_pdf.l10n_pe_external_layout"
                   t-lang="o.partner_id.lang">
                    <t t-set="o"
                       t-value="o.with_context({'lang':o.partner_id.lang})"/>
                </t>
            </t>
        </t>
    </template>

    <template id="l10n_pe_report_data_header">
        <style>
            .l10n_pe_header_invoice td {
            vertical-align: middle;
            }
            .l10n_company_name_container {
            /*margin: 0 0 7px 30px;*/
            margin: 0 0 0 15px;
            /*padding-bottom: 10px;*/
            padding-bottom: 5px;
            /*background-color: #C00000;*/
            display: inline-block;
            /*line-height: 1;*/
            }
            .company_address_footer {
            font-size: 12px;
            margin-left: 15px;
            /*text-align: center;*/
            text-align: left;
            position: relative;
            }
            #logo{
            height: 150px;
            }
        </style>
        <div>
            <div class="row">
                <div class="col-4">
                    <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" alt="Logo" style="max-height: 100px; max-width:260px"/>
                </div>
                <div class="col-8">
                   <div style="font-size:12px">
                        <strong>
                            <t t-esc="company.partner_id.name"/>
                        </strong>
                    </div>
                    <div style="font-size:12px">
                        <span t-field="company.partner_id.street"/><span> </span>
                        <span t-if="o.company_id.partner_id.l10n_pe_district" t-field="o.company_id.partner_id.l10n_pe_district" style="margin-left:5px"/>
                        -<span t-if="o.company_id.partner_id.city" t-field="o.company_id.partner_id.city"/>
                        -<span t-if="o.company_id.partner_id.state_id" t-field="o.company_id.partner_id.state_id.name"/>
                    </div>
                    <div style="font-size:10px; display: inline; ">

                    </div>
                    <div style="font-size:12px">
                        <span>Contacto:</span>
                        <span t-field="o.company_id.phone"/>
                        <span t-field="o.company_id.email" style="margin-left:10px"/>
                        <span t-field="o.company_id.website" style="margin-left:10px"/>

                    </div>
                </div>
            </div>
        </div>

    </template>
    <template id="l10n_pe_report_data_invoicing_content">
        <t t-set="o" t-value="o.with_context({'lang':o.partner_id.lang})"/>
        <t t-set="extra_edi_vals" t-value="o._l10n_pe_edi_get_extra_report_values()"/>
        <t t-set="spot" t-value="o._l10n_pe_edi_get_spot()"/>
