                                    FACTURA ELECTRÓNICA
                                </span>
                                <span class="invoice_type"
                                      t-if="o.move_type == 'out_invoice' and (o.state == 'posted') and o.l10n_latam_document_type_id.code == '03'">
                                    BOLETA DE VENTA ELECTRÓNICA
                                </span>
                                <span class="invoice_type" t-if="o.l10n_latam_document_type_id.code not in ['07','08','01','03']">
                                    <span t-field="o.journal_id.name"/><br/>
                                </span>
                                <span t-if="o.move_type == 'out_invoice' and o.state == 'draft'" style="font-size:12px">
                                    BORRADOR</span>
                                <span t-if="o.move_type == 'out_invoice' and o.state == 'cancel'" style="font-size:12px">
                                    COMPROBANTE CANCELADO
                                </span>
                            </div>
                        </div>

                        <div class="true_invoice_number t33 mt-2">
                            <strong>
                                <t t-esc="o.name"/>
