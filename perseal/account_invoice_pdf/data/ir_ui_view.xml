                        <div class="true_invoice_type t33">
                            <div class="invoice_type"
                                 t-if="o.move_type.endswith('refund') or o.l10n_latam_document_type_id.code in ['08','07']">
                                <strong>
                                    <span t-if="o.l10n_latam_document_type_id.code == '07'">
                                        NOTA DE CRÉDITO ELECTRÓNICA
                                    </span>
                                    <span t-if="o.l10n_latam_document_type_id.code == '08'">
                                        NOTA DE DÉBITO ELECTRÓNICA
                                    </span>
                                </strong>
<!--                                <span t-if="o.move_type == 'out_invoice' and o.state == 'draft'" style="font-size:12px">-->
<!--                                    BORRADOR</span>-->
<!--                                <span t-if="o.move_type == 'out_invoice' and o.state == 'cancel'" style="font-size:12px">-->
<!--                                    COMPROBANTE CANCELADO-->
<!--                                </span>-->
                            </div>
                            <div t-else="">
