                        </div>
                    </div>
                </div>
            </div>
            <br/>
            <table class="table text-left tbl_amount_detail" border="1">
                <t>
                    <tr>
                        <th colspan="7" style="text-align:left">
                            <t t-if="o.invoice_origin">
                                <strong>ORIGEN N°:</strong>
                                    <t t-esc="o.invoice_origin"/>
                            </t>
<!--                            <t t-if="o.l10n_latam_document_type_id.code in ['07', '08']">-->

                            <t t-if="o.invoice_payment_term_id">
                                | <strong>CONDICIONES DE PAGO:</strong>
                                    <t t-esc="str.replace(o.invoice_payment_term_id.name, 'Days', 'Dias')"/>
                            </t>
                            <t t-else="">
                                | <strong>CONDICIONES DE PAGO:</strong>
                                    Pago inmediato
                            </t>
                            <t t-if="o.invoice_user_id">
                                | <strong>VEND.:</strong>
                                <t t-esc="o.invoice_user_id.name"/>
                            </t>
                            <t t-if="o.ref">
                                | <strong>REF:</strong>
                                    <t t-esc="o.ref"/>
                            </t>
                        </th>
                    </tr>
                </t>
            </table>
            <!-- Is there a discount on at least one line? -->
            <t t-set="display_discount"
               t-value="any([l.discount for l in o.invoice_line_ids])"/>

            <table class="table table-condensed with_header_separator"
                   name="invoice_line_table">
                <thead>
                    <tr>
                        <th class="text-right hidden">CÓDIGO</th>
                        <th>Descripción</th>
                        <!--<th class="hidden">Source Document</th>-->
                        <th class="text-right">CANT.</th>
                        <th class="text-right">U.M.</th>
                        <th class="text-right">P.U.</th>
                        <th t-if="display_discount" class="text-right">
                            DESC.%</th>
                        <th class="text-right">IMPUESTO</th>
                        <th class="text-right">IMPORTE</th>
                    </tr>
                </thead>
                <tbody class="invoice_tbody">
                    <tr t-foreach="o.invoice_line_ids" t-as="l">
                        <t t-if="l.display_type != 'line_section'">
                            <td class="text-center hidden">
                                <span t-field="l.product_id.default_code"/>
                            </td>
                            <t t-if="o.company_id.show_code_invoice">
                                <t t-set="fin" t-value="l.name.find(']')" />
                                <t t-if="fin != -1">
                                    <td>
                                        <span>
                                            <t t-esc="str.replace(l.name, '\n', ' - ')[fin+1:]"/>
                                        </span>
                                    </td>
                                </t>
                                <t t-else="">
                                    <td>
                                        <span>
                                            <t t-esc="str.replace(l.name, '\n', ' - ')"/>
                                        </span>
                                    </td>
                                </t>
                            </t>
                            <t t-else="">
                                <td>
                                    <span>
                                        <t t-esc="str.replace(l.name, '\n', ' - ')"/>
                                    </span>
                                </td>

                            </t>
                            <td class="text-right">
                                <span t-field="l.quantity"/>
                            </td>
                            <td class="text-right">
                                <span t-field="l.product_uom_id.name"/>
                            </td>
                            <td class="text-right">
                                <span t-field="l.price_unit"/>
                            </td>
                            <td t-if="display_discount" class="text-right">
                                <span t-field="l.discount"/>
                            </td>
                            <td class="text-right">
                                <span t-esc="', '.join(map(lambda x: (x.tax_group_id.name), l.tax_ids))"/>
                            </td>
                            <td class="text-right" id="subtotal">
                                <span t-field="l.price_subtotal"
                                      t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </td>
                        </t>
                        <t t-else="l.display_type == 'line_section'">
                            <td colspan="8" style="border-top:1px solid black;border-bottom:1px solid black">
                                <strong>
                                    <span>
                                    <t t-esc="str.replace(l.name, '\n', ' - ')"/>
                                </span>
                                </strong>
                            </td>
                        </t>
                    </tr>
                    <tr t-foreach="range(max(5-len(o.invoice_line_ids),0))"
                        t-as="l">
                        <td></td>
                        <td class="hidden">&amp;nbsp;</td>
                        <!--<td class="hidden"></td>-->
                        <td></td>
                        <td></td>
                        <td></td>
                        <td t-if="display_discount"></td>
                        <td></td>
                        <td></td>
                    </tr>
                </tbody>
            </table>

            <div class="clearfix">
                <table class="table text-left tbl_amount_detail" border="1">
                    <t t-if="o.l10n_pe_edi_operation_type in ['1001','1002','1003','1004']">
                        <tr>
                            <th colspan="7"
                                style="border-bottom:1px solid #000;text-align:left !important;">
                                <strong>DETRACCIÓN (<span
                                        t-esc="o._amount_percent()"/>%):
                                        <span t-esc="o._amount_detration()"
                                              t-options='{"widget": "monetary", "display_currency": o._get_currency_detration_name()}'/>
                                    - Cta. Cte. Banco de la Nacion:
                                    <span t-esc="o._detration_banck()"/>
                                </strong>
                                <p><strong>Neto a pagar: </strong><span t-esc="o._net_payable(o.amount_total)" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></p>
                            </th>
                        </tr>
                    </t>
                    <t t-else="">
                        <tr style="display:none !important;">
                            <th colspan="7"
                                style="display:none !important;"></th>
                        </tr>
                    </t>
                    <tr>
                        <th colspan="7"
                            style="border-bottom:1px solid #5C5E5F;text-align:left !important;">
                            <strong>SON </strong>
                            <strong><t t-esc="o._l10n_pe_edi_amount_to_text()"/></strong>
                                <br t-if="o.l10n_pe_edi_legend_value != ''"/>
                                <span t-esc="o.l10n_pe_edi_legend_value" t-if="o.l10n_pe_edi_legend_value != ''"/>
                            
                        </th>
                    </tr>
                    <tr>
                        <td>SUBTOTAL de VENTA</td>
                        <td>VENTA</td>
                        <td>OPERACIONES GRATUITAS</td>
                        <td>I.G.V.</td>
<!--                        <t t-if="o.amount_isc">-->
<!--                            <td>I.S.C.</td>-->
<!--                        </t>-->
                        <td>OTROS CARGOS</td>
                        <td>TOTAL</td>
                    </tr>
                    <tr>
                        <td>
                            <span t-esc="o._get_amount_untaxed()"
                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                        </td>
                        <td>
                            <span t-esc="o._get_amount_untaxed()"
                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                        </td>
                        <td>
                            <span t-esc="o._free_operations()"
                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                        </td>
                        <td>
                            <span t-esc="o._amount_igv()"
                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                        </td>
                        <td>
                            <span t-esc="o._other_charges()"
                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                        </td>
                        <td>
                            <span t-field="o.amount_total"
                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                        </td>
                    </tr>
                </table>


                <div class="div_total" style="display:none;">
                    <table class="table-condensed">
                        <tr class="border-black"
                            style="border-bottom:1px solid #dddddd;">
                            <td>
                                <strong>Subtotal</strong>
                            </td>
                            <td class="text-right">
                                <span t-field="o.amount_untaxed"
                                      t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </td>
                        </tr>
                        <tr class="border-black">
                            <td>
                                <strong>Total</strong>
                            </td>
                            <td class="text-right">
                                <span t-field="o.amount_total"
                                      t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>

            <t t-if="o._payment_credit()">
            <div class="clearfix">
                <table t-if="o.invoice_cred" class="table text-left tbl_amount_detail" border="1">
                    <th colspan="7"
                                style="border-bottom:1px solid #5C5E5F;text-align:left !important;">
                                <strong>
                                    INFORMACIÓN DE CUOTAS
                                </strong>
                            </th>
                        <tr>
                            <td>Nro Cuota</td>
                            <td>Monto Cuota</td>
                            <td>Fecha Vencimiento</td>
                        </tr>
                        <tr t-foreach="o.invoice_cred" t-as="credit">
                        <tr>
                            <td>
                                <span t-field="credit.number_due"/>
                            </td>
                            <td>
                                <span t-field="credit.amount_due"
                                      t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </td>
                            <td>
                                <span t-if="credit.expiration_date"
                                      t-esc="credit.expiration_date.strftime('%d/%m/%Y')"/>
                            </td>
                        </tr>
                    </tr>
                </table>
            </div>
            </t>

            <!-- RETENCIONES -->
            <t t-if="o._agent_retention()">
                <t t-set="retention" t-value="o._prepare_retention()"/>
                <t t-if="retention">
                    <div class="clearfix">
                        <table class="table text-left tbl_amount_detail" border="1">
                            <th colspan="8" style="border-bottom:1px solid #5C5E5F;text-align:left !important;">
                                <strong>INFORMACIÓN DE RETENCIÓN</strong>
                            </th>
                            <tr>
                                <td style="border: 0px !important"><span><strong>Monto total:</strong></span></td>
                                <td style="border: 0px !important"><span><t t-esc="retention['BaseAmount']" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></span></td>
                                <td style="border: 0px !important"><span><strong>Porcentaje:</strong></span></td>
                                <td style="border: 0px !important"><span><t t-esc="retention['MultiplierFactorNumeric'] * 100"/>%</span></td>
                                <td style="border: 0px !important"><span><strong>Retención:</strong></span></td>
                                <td style="border: 0px !important"><span><t t-esc="retention['Amount']" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></span></td>
                                <td style="border: 0px !important"><span><strong>Neto a Pagar:</strong></span></td>
                                <td style="border: 0px !important"><span><t t-esc="retention['BaseAmount'] - retention['Amount']" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></span></td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>


            <div class="clear">
                <t t-if="o.narration">
                    <div class="row" style="padding-top: 20px; padding-bottom: 20px;">
                        <div class="col-12">
                            <strong>Observaciones:</strong>
                            <p t-field="o.narration"/>
                        </div>
                    </div>
                </t>

                <p t-if="extra_edi_vals">
                    <img t-attf-src="/report/barcode/QR/{{extra_edi_vals['qr_str']}}?&amp;width=100&amp;height=100&amp;quiet=0" width="100" height="100" alt="QR Code"/>
                </p>
                <t t-set="show_qr" t-value="o.display_qr_code and o.amount_residual > 0"/>
                <div t-if="not show_qr" name="qr_code_placeholder" class="oe_structure"></div>
                <div id="qrcode" class="d-flex mb-3 avoid-page-break-inside" t-else="">
                    <div class="qrcode me-3" id="qrcode_image">
                        <t t-set="qr_code_url" t-value="o._generate_qr_code(silent_errors=True)"/>
                        <p t-if="qr_code_url" class="position-relative mb-0">
                            <img t-att-src="qr_code_url"/>
                            <img src="/account/static/src/img/Odoo_logo_O.svg"
                                 id="qrcode_odoo_logo"
                                 class="top-50 start-50 position-absolute bg-white border border-white border-3 rounded-circle"
                            />
                        </p>
                    </div>
<!--                    <div class="d-inline text-muted lh-sm fst-italic" id="qrcode_info" t-if="qr_code_url">-->
<!--                        <p>Scan this QR Code to<br/>pay with your mobile</p>-->
<!--                    </div>-->
                </div>
                <h5 t-if="company.report_header" class="mt0 text-right" t-field="company.report_header"/>
            </div>

        </div>
    </template>
    <template id="l10n_report_data_footer">
        <div class="l10n_pe text-left">
            <ul class="list-inline" style="display:none;">
                <li t-if="company.phone">Tel:
                    <span t-field="company.phone"/>
                </li>
                <li t-if="company.email">Mail:
                    <span t-field="company.email"/>
                </li>
                <li t-if="company.website">Web:
                    <span t-field="company.website"/>
                </li>
                <li t-if="company.vat"><t
                        t-esc="company.country_id.vat_label or 'TIN'"/>:
                    <span t-field="company.vat"/>
                </li>
            </ul>
            <div class="div_footer" t-field="company.report_footer"
                 style="margin-top:3px;"/>
            <div class="text-right">
                Página:
                <span class="page"/>
                /
                <span class="topage"/>
            </div>
        </div>
    </template>
</odoo>
