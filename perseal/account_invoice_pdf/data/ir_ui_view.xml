            <div class="div_customer_and_ruc_containner">
                <div class="div_customer_data rounded">
                    <table class="tbl_customer_data">
                        <tr class="">
                            <td>
                                <strong>FECHA.FAC.:</strong>
                            </td>
                            <td>
                                <span>
                                    <t t-esc="o.invoice_date"/>
                                </span>
                                <span class="span_date_invoice">
                                    <strong>FECHA.VENC.:</strong>
                                    <span>
                                        <t t-esc="o.invoice_date_due"/>
                                    </span>
                                </span>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <strong>CLIENTE:</strong>
                            </td>
                            <td>
                                <div class="cust_partner_name"
                                     t-if="o.partner_id.parent_id ">
                                    <address t-field="o.partner_id.parent_id"
                                             t-options='{"widget": "contact", "fields": ["name"], "no_marker": True}'/>
                                </div>
                                <div class="cust_partner_name" t-else="">
                                    <address t-field="o.partner_id"
                                             t-options='{"widget": "contact", "fields": ["name"], "no_marker": True}'/>
                                </div>

                            </td>
                        </tr>
                        <tr>
                            <td>
                                <strong>DIRECCIÓN:</strong>
                            </td>
                            <td>

                                <t t-if="o.partner_id.parent_id">
                                    <span t-field="o.partner_id.parent_id.street"></span>
                                    .
                                    <t t-if="o.partner_id.parent_id.street2">
                                        <span t-field="o.partner_id.parent_id.street2"></span>
                                    </t>
                                    <br/><span
                                        t-field="o.partner_id.parent_id.state_id.name"></span> <span
                                        t-field="o.partner_id.parent_id.zip"></span>
                                    <br/><span
                                        t-field="o.partner_id.parent_id.country_id.name"></span>
                                </t>
                                <t t-else="">
                                    <span t-field="o.partner_id.street"></span>.
                                    <t t-if="o.partner_id.street2">
                                        <span t-field="o.partner_id.street2"></span>
                                        .
                                    </t>
                                    <span t-field="o.partner_id.city"></span>
                                    <br/><span
                                        t-field="o.partner_id.state_id.name"></span> <span
                                        t-field="o.partner_id.zip"></span>
                                    <br/><span
                                        t-field="o.partner_id.country_id.name"></span>
                                </t>

                            </td>
                        </tr>
                        <tr>
                            <td>
                                <strong><span t-field="o.partner_id.l10n_latam_identification_type_id.name"/><span>:</span></strong>
                            </td>
                            <td>
                                <div style="display:inline-block"
                                     class="cust_partner_doc_number"
                                     t-if="o.partner_id.parent_id ">
                                    <span t-field="o.partner_id.parent_id.vat"/>
                                </div>
                                <div class="cust_partner_doc_number" t-else="">
                                    <span t-field="o.partner_id.vat"/>
                                </div>
                                <span class="span_date_invoice">
                                    <strong>MONEDA:</strong>
                                    <span>
                                        <t t-esc="o.currency_id.name"/>
                                    </span>
                                </span>
                            </td>
                        </tr>
                    </table>
                </div>
                <div class="div_ruc_number">
                    <div class="aux">
