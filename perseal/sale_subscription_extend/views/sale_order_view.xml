<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_order_form_quote_extend" model="ir.ui.view">
        <field name="name">sale.order.form.quote.extend</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_management.sale_order_form_quote"/>
        <field name="priority" eval="10"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='other_information']/group/group[@name='sale_info']/field[@name='journal_id']" position="after">
                <field name="auto_published_invoice"/>
            </xpath>
        </field>
    </record>
</odoo>