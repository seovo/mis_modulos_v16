<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="website_sale_customer_comment" inherit_id="website_sale.payment">     
        <xpath expr="//div[@id='oe_structure_website_sale_payment_1']" position="after">
        <!-- <xpath expr="//div[@id='payment_method']" position="before"> -->
            <div class="mb8 row">
                <div t-attf-class="form-group mb-4">
                    <label class="control-label" for="customer_comment">
                        <h4>Tipo de Documento</h4>
                    </label>
                    <div>
                        <input type="radio" class="form-check-input" name="tipo_comprobante" id="customer_comment1"  value="factura" checked="'checked'" style="margin-left: 30px;"/>
                        <label class="form-check-label fw-normal" for="wsale_factura">Factura</label>
                        <input type="radio" class="form-check-input" name="tipo_comprobante" id="customer_comment" value="boleta"/>
                        <label class="form-check-label fw-normal" for="wsale_boleta">Boleta</label>
                    </div>
                </div> 
            </div>  
        </xpath>
    </template>
</odoo>
