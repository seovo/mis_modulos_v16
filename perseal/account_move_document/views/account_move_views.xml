<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_account_journal_form_inherit_l10n_pe_ple" model="ir.ui.view">
        <field name="name">view.account.journal.form.inherit.l10n.pe.ple</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <field name="currency_id" position="after">
                <field name="apertura" groups="base.group_no_one"/>
                <field name="cierre" groups="base.group_no_one"/>
            </field>
        </field>
    </record>

    <record id="view_move_form_inherit_documento_en_asiento_contable" model="ir.ui.view">
        <field name="name">view.move.form.inherit.documento.en.asiento.contable</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_vendor_bill_id']" position="after">
                <field name="apertura" invisible="1"/>
                <field name="cierre" invisible="1"/>
            </xpath>
            <xpath expr="//page[@id='aml_tab']/field[@name='line_ids']/tree/field[@name='name']" position="before">
                <field name="documento" column_invisible="parent.apertura == False and parent.cierre == False"/>
            </xpath>
        </field>
    </record>

</odoo>