<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="search_template_account_account">
        <button type="button" class="o-no-caret btn btn-secondary dropdown-toggle" data-toggle="dropdown">
            <span class="fa fa-filter"/> Filtros
        </button>
        <div class="dropdown-menu o_filter_menu" role="menu">
            <t>
                <a role="menuitem" class="dropdown-item js_cuenta_x_cobrar" title="Cuentas por cobrar" data-filter="cuenta_x_cobrar">Cuentas por cobrar</a>
                <a role="menuitem" class="dropdown-item js_cuenta_x_pagar" title="Cuentas por pagar" data-filter="cuenta_x_pagar">Cuentas por pagar</a>
                <a role="menuitem" class="dropdown-item js_bank_x_cash" title="Banco y efectivo" data-filter="bank_x_cash">Banco y efectivo</a>

<!--                <a role="menuitem" class="dropdown-item js_bank_x_cash" title="Banco y efectivo" data-filter="bank_x_cash">Banco y efectivo</a>-->
            </t>
        </div>
    </template>

    <template id="search_template_inherit"  inherit_id="account_reports.search_template">
        <xpath expr="//div[hasclass('o_account_reports_filter_date')]" position="before">
            <div class="btn-group dropdown o_account_reports_filter_account_account" t-if="options.get('currency_rates')">
                <t t-call="account_report_extend.search_template_account_account"/>
            </div>
        </xpath>
    </template>

    <template id="search_template_currency_inherit" inherit_id="account_reports.search_template_currency">
        <xpath expr="//div[hasclass('o_filters_menu')]" position="replace">
            <div class="dropdown-menu o_filters_menu" role="menu">
                <div class="o_account_report_search" data-filter='custom_currency'>
                    <div t-foreach="options['currency_rates'].values()" t-as="opt" class="form-group">
                        <label t-att-for="opt['currency_id']">1 <t t-esc="opt['currency_name']"/> <i class="fa fa-arrow-right"/> <t t-esc="opt['currency_main']"/></label>
                        <input t-att-value="1/opt['rate']" t-att-name="opt['currency_id']" type="number" min="0" step="0.000001" class="js_account_report_custom_currency_input"/>
                    </div>
                    <button type="button" class="btn btn-primary js_account_report_custom_currency" data-filter="custom_currency">Apply</button>
                </div>
            </div>
        </xpath>
    </template>
</odoo>