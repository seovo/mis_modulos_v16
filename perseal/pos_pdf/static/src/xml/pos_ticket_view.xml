<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_pdf.ReceiptHeader" t-inherit="point_of_sale.ReceiptHeader" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('cashier')]" position="replace">
            <div><t t-esc="props.data.order_document_type"/> Electrónica</div>
            <div><t t-esc="props.data.invoice_name"/></div>
            <div>Fecha: <t t-esc="props.data.receipt_date"/></div>
        </xpath>
        <xpath expr="//div[hasclass('fw-bolder')]" position="replace">
        </xpath>
    </t>
    <t t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos-receipt-taxes')]" position="replace">
        </xpath>

        <xpath expr="//div[hasclass('pos-receipt')]/div[last()]" position="replace">
            <div>Usuario: <t t-esc="props.data.cashier"/></div>
            <div>Cliente: <t t-esc="props.data.customer.name"/></div>
            <div>Número de documento: <t t-esc="props.data.customer.vat"/></div>
            <div>Dirección:
                <t t-if="props.data.customer.street" t-esc="props.data.customer.address"/>
            </div>
            <div>--------------------------------</div>
        </xpath>
        <xpath expr="//OrderWidget" position="replace">
            <table style="width: 100%;">
                <colgroup>
                    <col width='40%'/>
                    <col width='20%'/>
                    <col width='20%'/>
                    <col width='20%'/>
                </colgroup>
                <tr style="border: 1px solid rgb(0, 0, 0);">
                    <th>Product</th>
                    <th style="text-align:center">Qty</th>
                    <th style="text-align:center">P. Unit</th>
                    <th style="text-align:center">Subtotal</th>
                </tr>
            </table>
            <OrderWidget lines="props.data.orderlines" t-slot-scope="scope">
                <t t-set="line" t-value="scope.line"/>
                <table style="width: 100%;margin:0px">
                <colgroup>
                    <col width='40%'/>
                    <col width='20%'/>
                    <col width='20%'/>
                    <col width='20%'/>
                </colgroup>
                <tr>
                   <td style="font-size:11px">
                        <t t-esc="line.productName"/>
                        <t t-if="line.discount > 0">
                            <div class="pos-disc-font">
                                Con un <t t-esc="line.discount"/>% descuento
                            </div>
                        </t>
                    </td>
                    <td style='text-align:center;font-size:11px'>
                        <t t-esc="line.qty"/>
                    </td>
                    <td style='text-align:left;font-size:11px'>
                        <t t-esc='line.unitPrice'/>
                    </td>
                    <td style='text-align:left;font-size:11px'>
                        <t t-esc="line.price"/>
                    </td>
                </tr>
                </table>
            </OrderWidget>
            <br/>
            <div t-if="props.data.tax_details.length > 0" class="pos-receipt-taxes">
                <span />
                <span>TAX%</span>
                <span>Tax</span>
                <span>Base</span>
                <span>Total</span>
                <t t-foreach="props.data.tax_details" t-as="tax" t-key="tax.tax.id">
                    <span t-esc="tax.tax.letter || ''"/>
                    <span><t t-esc="tax.tax.amount"/> %</span>
                    <span t-esc="props.formatCurrency(tax.amount, false)" />
                    <span t-esc="props.formatCurrency(tax.base, false)" />
                    <span t-esc="props.formatCurrency(tax.amount + tax.base, false)" />
                </t>
                <t t-if="props.data.tax_details.length > 1">
                    <span />
                    <span />
                    <span t-esc="props.formatCurrency(props.data.amount_tax, false)" />
                    <span t-esc="props.formatCurrency(props.data.total_without_tax, false)" />
                    <span t-esc="props.formatCurrency(props.data.amount_total, false)" />
                </t>
            </div>
        </xpath>
    </t>
</templates>
