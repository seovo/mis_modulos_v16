<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form" model="ir.ui.view">
           <field name="name">account.move</field>
           <field name="model">account.move</field>
           <field name="inherit_id" ref="account.view_move_form"/>
           <field name="arch" type="xml">
               <xpath expr="//header" position="inside">
                   <button name="send_smc_data" type="object"
                           string="Enviar SMC" />
                   <!-- invisible="not server_vex"  -->

               </xpath>

               <xpath expr="//notebook" position="inside">
                   <page id="smc_tab" string="SMC" >
                       <group>
                           <field name="clave_colonia_smc" />
                       </group>

                       <field name="log_smc" />
                       <field name="xml_send_smc" />
                   </page>

               </xpath>

           </field>
    </record>



    <record id="view_move_form_smc" model="ir.ui.view">
           <field name="name">account.move</field>
           <field name="model">account.move</field>
           <field name="priority">100</field>
           <field name="arch" type="xml">
               <form>
                   <group>
                       <field name="clave_colonia_smc" required="True" />
                       <field name="type_negocio_area_smc"  required="True" />
                       <field name="area_empresarial_smc"  required="True" />
                   </group>
                   <footer>
                       <button name="send_smc_data" string="Enviar SMC"
                            type="object" class="oe_highlight" />

                       <button string="Cancel" class="oe_link" special="cancel"/>
                   </footer>

               </form>
           </field>
    </record>






</odoo>
