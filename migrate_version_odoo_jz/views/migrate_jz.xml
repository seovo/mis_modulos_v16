<odoo>


    <record model="ir.ui.view" id="migrate_model_jz_form" >
        <field name="name">migrate.model.jz.form</field>
        <field name="model">migrate.model.jz</field>
        <field name="arch" type="xml">
            <form string="Migracion">
                <header>

                     <button name="migrate_table" string="Sincronizar" type="object" />



                </header>
                <sheet>





                    <group>
                        <group>
                            <field name="model_id"/>
                            <field name="update_if_exist"/>
                            <field name="ignorar_if_error"/>
                            <field name="where_set"/>

                        </group>
                        <group>
                            <field name="table" />
                            <field name="identificador" />
                            <field name="new_table" />
                            <field name="no_existe_id" />
                        </group>



                    </group>

                    <notebook>
                        <page string="Campos" name="columns">
                            <field name="columns">
                                <list editable="bottom">
                                    <field name="name" />
                                    <field name="ignore" />
                                    <field name="type_field" />
                                    <field name="value_set" />
                                    <field name="is_field" optional="hidden" />
                                   <!-- <field name="insert_as_jsonb" optional="hidden" /> -->
                                </list>
                            </field>
                            <group name="note_group" col="6" class="mt-2 mt-md-0">
                               <group colspan="4">
                                   <field colspan="2" name="log"/>
                               </group>

                            </group>
                        </page>

                        <page string="Configuraciones">
                             <group>
                                 <field name="is_part_cron" />
                                 <field name="last_value" />
                                 <field name="records_value" />
                             </group>

                        </page>


                    </notebook>

                </sheet>


            </form>
        </field>
    </record>


    <record model="ir.ui.view" id="migrate_jz_form" >
        <field name="name">migrate.jz.form</field>
        <field name="model">migrate.jz</field>
        <field name="arch" type="xml">
            <form string="Migracion">
                <header>

                     <button name="conect_postgres"
                             string="Test Conexion" type="object"
                           />
                    <button name="add_modelos_usuales" string="Modelos Usuales" type="object" />



                </header>
                <sheet>

                    <div class="oe_button_box" name="button_box">
                       <button name="show_lines" type="object" class="oe_stat_button"
                               icon="fa-pencil-square-o" />


                    </div>



                    <group>
                        <group>
                            <field name="host"/>
                            <field name="port"/>
                            <field name="from_version"/>
                        </group>
                        <group>
                            <field name="dbname" password="true" />
                            <field name="user"  pasword="true"  password="true" />
                            <field name="password" password="true" />

                        </group>






                    </group>

                    <notebook>
                        <page string="Modelos" name="mode_ids">


                            <field name="model_ids" />

                            <group name="note_group" col="6" class="mt-2 mt-md-0">
                               <group colspan="4">
                                   <field colspan="2" name="log"/>
                               </group>

                            </group>
                        </page>


                        <page string="Campos Odoo" name="columns">
                            <field name="field_ids">
                                <list editable="bottom">
                                    <field name="id_sql" />
                                    <field name="name" />
                                    <field name="model" />
                                    <field name="ir_model_fields_id" />
                                </list>
                            </field>
                        </page>


                        <page string="Diarios" name="diarios">
                            <field name="journal_migration_ids">
                                <list editable="bottom">
                                    <field name="id_sql" />
                                    <field name="name" />
                                    <field name="journal_id" />
                                </list>
                            </field>
                            <group>
                                <field name="text_journal" />
                            </group>
                        </page>

                        <page string="Moneda" name="monedas">
                            <field name="currency_migration_ids">
                                <list editable="bottom">
                                    <field name="id_sql" />
                                    <field name="name" />
                                    <field name="currency_id" />
                                </list>
                            </field>
                            <group>
                                <field name="text_currency" />
                            </group>
                        </page>


                        <page string="Cuentas" name="account">
                            <field name="account_migration_ids">
                                <list editable="bottom">
                                    <field name="id_sql" />
                                    <field name="code" />
                                    <field name="name" />
                                    <field name="account_id" />
                                </list>
                            </field>
                            <group>
                                <field name="text_account" />
                            </group>
                        </page>

                        <page string="Impuestos" name="taxs">
                            <field name="tax_migration_ids">
                                <list editable="bottom">
                                    <field name="id_sql" />
                                    <field name="name" />
                                    <field name="tax_id" />
                                </list>
                            </field>
                            <group>
                                <field name="text_tax" />
                            </group>
                        </page>

                        <page string="Ubicaciones" name="Ubicaciones">
                            <field name="location_migration_ids">
                                <list editable="bottom">
                                    <field name="id_sql" />
                                    <field name="name" />
                                    <field name="location_id" />
                                </list>
                            </field>
                            <group>
                                <field name="text_location" />
                            </group>
                        </page>

                        <page string="Paises" name="Paises">
                            <field name="country_migration_ids">
                                <list editable="bottom">
                                    <field name="id_sql" />
                                    <field name="name" />
                                    <field name="country_id" />
                                </list>
                            </field>
                            <group>
                                <field name="text_country" />
                            </group>
                        </page>

                        <page string="Estados" name="Estados">
                            <field name="state_migration_ids">
                                <list editable="bottom">
                                    <field name="id_sql" />
                                    <field name="name" />
                                    <field name="state_id" />
                                </list>
                            </field>
                            <group>
                                <field name="text_state" />
                            </group>
                        </page>

                        <page string="City" name="City">
                            <field name="city_migration_ids">
                                <list editable="bottom">
                                    <field name="id_sql" />
                                    <field name="name" />
                                    <field name="city_id" />
                                </list>
                            </field>
                            <group>
                                <field name="text_city" />
                            </group>
                        </page>


                    </notebook>

                </sheet>


            </form>
        </field>
    </record>

    <record id="action_migrate_jz" model="ir.actions.act_window">
        <field name="name">Migracion V18</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">migrate.jz</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem action="action_migrate_jz"
              id="menu_migrate_jz"
              web_icon="migrate_version_odoo_jz,static/description/icon.png"
    />

</odoo>
