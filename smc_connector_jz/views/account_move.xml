<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_invoice_tree" model="ir.ui.view">
           <field name="name">account.move</field>
           <field name="model">account.move</field>
           <field name="inherit_id" ref="account.view_invoice_tree"/>
           <field name="arch" type="xml">
               <field name="state" position="after" >
                   <field name="state_smc" optional="hide"/>
               </field>
           </field>
    </record>

    <record id="view_move_form" model="ir.ui.view">
           <field name="name">account.move</field>
           <field name="model">account.move</field>
           <field name="inherit_id" ref="account.view_move_form"/>
           <field name="arch" type="xml">
               <xpath expr="//header" position="inside">
                   <button name="send_smc_data" type="object"
                           attrs="{'invisible': [('state', '!=', 'posted' )]}"

                           string="Enviar SMC" />
                   <!-- invisible="not server_vex"  -->

               </xpath>

               <xpath expr="//notebook" position="inside">
                   <page id="smc_tab" string="SMC" >

                       <field name="smc_model_ids" />

                       <field name="log_smc" attrs="{'invisible':[ '|',('smc_model_ids', '=', False),('state_smc','!=','error')]}"  />


                   </page>

               </xpath>

               <field name="currency_id" position="after" >
                   <field name="state_smc" attrs="{'invisible':[ ('smc_model_ids', '=', [])]}"/>
                   <field name="log_smc" attrs="{'invisible':[ '|',('smc_model_ids', '=', []),('state_smc','!=','error')]}"  />
               </field>

           </field>
    </record>


    <record id="view_move_form_smc" model="ir.ui.view">
           <field name="name">account.move</field>
           <field name="model">account.move</field>
           <field name="priority">100</field>
           <field name="arch" type="xml">
               <form>
                   <group>
                       <field name="clave_colonia_smc" required="True" />
                       <field name="type_negocio_area_smc"  required="True" />
                       <field name="area_empresarial_smc"  required="True" />
                       <field name="state" invisible="1" />
                   </group>
                   <footer>
                       <button name="send_smc_data" string="Enviar SMC"
                               attrs="{'invisible': [('state', '!=', 'posted' )]}"
                               type="object" class="oe_highlight" />

                       <button name="action_post" string="Publicar" class="oe_highlight"
                               type="object" groups="account.group_account_invoice"
                               attrs="{'invisible': [('state', '!=', 'draft')]}"/>

                       <button string="Cancel" class="oe_link" special="cancel"/>
                   </footer>

               </form>
           </field>
    </record>

    <record id="multi_meli_validate_logistic" model="ir.actions.server">
			<field name="name">Enviar SMC</field>
			<field name="model_id" ref="smc_connector_jz.model_account_move" />
			<field name="binding_model_id" ref="smc_connector_jz.model_account_move" />
			<field name="state">code</field>
			<field name="code">action = records.send_masive_smc()</field>
    </record>


</odoo>
