<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="smc_model_form" model="ir.ui.view">
           <field name="name">smc.model.form</field>
           <field name="model">smc.model</field>

           <field name="arch" type="xml">
               <form>
                   <header>
                       <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                   </header>
                   <sheet>
                       <group>
                           <group>
                               <field name="move_id" readonly="1" force_save="1" />
                               <field name="cliente" readonly="1" force_save="1" />
                               <field name="rfc" readonly="1" force_save="1" />
                               <field name="razon_social" readonly="1" force_save="1" />
                               <field name="codigo_postal" readonly="1" force_save="1" />
                               <field name="colonia" readonly="1" force_save="1" />
                               <field name="calle" readonly="1" force_save="1" />
                               <field name="numero_exterior" readonly="1" force_save="1" />
                               <field name="tipo_negocio_area" readonly="1" force_save="1" />
                               <field name="area_empresarial" readonly="1" force_save="1" />

                           </group>
                           <group>
                               <field name="uuid" readonly="1" force_save="1" />
                               <field name="folio_factura" readonly="1" force_save="1" />
                               <field name="serie" readonly="1" force_save="1" />
                               <field name="fecha_factura" readonly="1" force_save="1" />
                               <field name="tipo_comprobante" readonly="1" force_save="1" />
                               <field name="moneda" readonly="1" force_save="1" />
                               <field name="tipoCambio" readonly="1" force_save="1" />
                               <field name="subtotal" readonly="1" force_save="1" />
                               <field name="descuento" readonly="1" force_save="1" />
                               <field name="iva" readonly="1" force_save="1" />
                               <field name="total" readonly="1" force_save="1" />


                           </group>
                       </group>
                       <notebook>
                           <page id="aml_tab" string="Items" >
                                <field name="line_ids" />
                           </page>
                       </notebook>
                   </sheet>
               </form>
           </field>
    </record>

    <record id="action_smc_model" model="ir.actions.act_window">
        <field name="name">Facturas SMC</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">smc.model</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem action="action_smc_model" id="menu_action_smc_model"
              parent="account.menu_finance_receivables" sequence="12" />
</odoo>