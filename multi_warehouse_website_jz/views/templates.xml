<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="warehouse_selector" name="Warehouse Selector">
        <t t-nocache="The query strings can change for the same page and the same rendering." t-nocache-no_text="no_text" t-nocache-codes="codes" t-nocache-_div_classes="_div_classes" t-nocache-_btn_class="_btn_class" t-nocache-_txt_class="_txt_class" t-nocache-_dropdown_menu_class="_dropdown_menu_class">





          <!--<t t-set="active_warehouse" t-value="list(filter(lambda lg : lg[0] == warehouse, warehouses))[0]"/> -->

          <t t-set="active_warehouse" t-value="warehouse if warehouse else warehouses[0]"/>





            <t t-set="warehouse_selector_visible" t-value="len(warehouses) &gt; 1"/>
            <div t-attf-class="js_language_selector #{_div_classes} d-print-none" t-if="warehouse_selector_visible">
                <button t-attf-class="btn border-0 dropdown-toggle #{_btn_class or 'btn-sm btn-outline-secondary'}" type="button" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="true">
                    <i class="fa fa-fw fa-truck"></i>
                    <span t-if="not no_text" t-attf-class="align-middle #{_txt_class}" t-esc="active_warehouse.name"/>
                   <!-- <span t-elif="codes" class="align-middle" t-esc="active_warehouse[1].split('_').pop(0).upper()"/>  -->
                </button>

                <div t-attf-class="dropdown-menu #{_dropdown_menu_class}" role="menu">
                    <t t-foreach="warehouses" t-as="lg">
                         <a t-attf-class="dropdown-item js_change_lang #{active_warehouse == lg and 'active'}"
                            t-att-href="url_for('/set_warehouse_session/' + str(lg[0].id) + '?' + keep_query())"
                         >



                             <span  t-esc="lg.name" t-attf-class="#{_txt_class}"/>


                         </a>


                        <!--
                        <a class="dropdown-item" t-att-href="url_for(request.httprequest.path + '?' + keep_query(), lang_code=lg[0])"
                        t-attf-class="dropdown-item js_change_lang #{active_warehouse == lg and 'active'}"
                        t-att-data-url_code="lg[1]" t-att-title="lg.name">
                            <span t-if="not no_text" t-esc="lg[2].split('/').pop()" t-attf-class="#{_txt_class}"/>
                            <span t-elif="codes" t-esc="lg[1].split('_').pop(0).upper()" t-attf-class="align-middle #{_txt_class}"/>
                        </a>

                        -->
                    </t>
                </div>

            </div>
        </t>
    </template>


    <template id="header_warehouse_selector" inherit_id="website.placeholder_header_language_selector"
              name="Header Warehouse Selector" active="True">
         <xpath expr="." position="inside">
        <li data-name="Warehouse Selector" t-attf-class="o_header_language_selector #{_item_class}">
            <t id="header_warehouse_selector_call" t-call="multi_warehouse_website_jz.warehouse_selector">
                <t t-set="_div_classes" t-value="(_div_classes or '') + ' dropdown'"/>
            </t>
        </li>
    </xpath>
    </template>

</odoo>