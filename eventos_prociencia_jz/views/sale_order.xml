<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form" model="ir.ui.view">
           <field name="name">Pedidos.Form</field>
           <field name="model">sale.order</field>
           <field name="inherit_id" ref="sale.view_order_form" />
           <field name="arch" type="xml">

               <xpath expr="//header" position="inside" >

                   <field name="delivery_count" invisible="1" />

                   <button name="action_confirm_event"  string="Confirmar Listado" class="btn-primary"
                           type="object" invisible="state != 'done'  and delivery_count > 1 "/>
               </xpath>

               <xpath expr="//page[@name='order_lines']" position="after" >
                   <page string="Pagos" name="payments_sale">
                           <field name="payments_sale_order"   >
                              <tree  editable="bottom" >
                                  <field name="amount" sum="Total" />
                                  <field name="date" />
                                  <field name="note" />

                              </tree>
                           </field>
                           <!--
                          <group>
                           <field name="amount_total" />
                           <field name="total_purchase" />
                           <field name="neto_amount_total" />
                       </group>
                           -->
                       </page>

               </xpath>

               <xpath expr="//notebook" position="inside" >

                   <field name="delivery_count" invisible="1" />

                   <page string="Especificaciones Cliente" name="note1">
                       <field name="note_event_start" readonly="delivery_count > 1" />
                   </page>
                   <page string="Contra Rider" name="note1">
                       <field name="note_event_end" readonly="delivery_count > 1" />
                   </page>
                   <page string="Listado Items" name="note1">
                       <field name="event_line_ids"  widget="section_and_note_one2many" readonly="delivery_count > 1" >
                           <tree  editable="bottom"
                                  decoration-warning=" margin_stock_warning >  margin_stock_danger and  ( margin_stock_warning >= qty_available   ) and not is_external and not display_type"
                                  decoration-danger="( margin_stock_danger >= qty_available   ) and not is_external and not display_type"
                                  decoration-success="(  qty_available > margin_stock_warning   and qty_available > margin_stock_danger ) and not is_external and not display_type"

                                  decoration-info="is_external == True" >
                               <control>
                                    <create name="add_product_control" string="Agregar Producto"/>
                                    <create name="add_product_control" string="Agregar Producto Externo"  context="{'default_is_external': True}" />
                                    <create name="add_section_control" string="Agregar Sección" context="{'default_display_type': 'line_section'}"/>
                                    <create name="add_note_control" string="Agregar Nota" context="{'default_display_type': 'line_note'}"/>
                                </control>
                               <!--


                                -->
                               <field name="sequence" widget="handle"/>
                               <field name="name" widget="section_and_note_text"  />
                               <field name="product_id" />
                               <field name="is_external" optional="hide"  />
                               <field name="quantity" />
                               <field name="qty_available" />
                               <field name="margin_stock_danger" optional="hide" />
                               <field name="margin_stock_warning" optional="hide"  />
                               <button name="get_lines_dates" type="object" icon="fa-eye" />
                               <field name="check1" />
                               <field name="user1" optional="hide" />
                               <field name="check2" />
                               <field name="user2" optional="hide"  />
                               <field name="check3" />
                               <field name="user3" optional="hide"  />
                               <field name="display_type"  column_invisible="True" />

                           </tree>
                       </field>
                   </page>


               </xpath>

               <xpath expr="//field[@name='partner_shipping_id']" position="after" >
                   <field name="name_event" />
                   <field name="place_event_id" />
               </xpath>

               <xpath expr="//field[@name='payment_term_id']" position="after" >
                   <field name="crm_lead_id" invisible="1" />
                   <field name="date_event" />

                    <div class="o_td_label" >
                        <label for="date_event_install" string="Fecha Instalación" />
                    </div>

                    <div class="d-flex" >
                        <field name="date_event_install" required="date_event_install or date_event_install_end"  />
                        <span class="o_form_label mx-8 oe_edit_only" > - </span>
                        <field name="date_event_install_end"  required="date_event_install"  />
                    </div>

                   <!-- Fecha de Sonido -->

                   <div class="o_td_label" >
                        <label for="date_event_sound" />
                    </div>


                    <div class="d-flex" >
                        <field name="date_event_sound" required="date_event_sound_end"  />
                        <span class="o_form_label mx-8 oe_edit_only" > - </span>
                        <field name="date_event_sound_end"   required="date_event_sound" />
                    </div>

                   <!-- fecha de desistalacion -->


                    <div class="o_td_label" >
                        <label for="date_event_uninstall" />
                    </div>


                    <div class="d-flex" >
                        <field name="date_event_uninstall" required="date_event_uninstall or date_event_uninstall_end"  />
                        <span class="o_form_label mx-8 oe_edit_only" > - </span>
                        <field name="date_event_uninstall_end"   required="date_event_uninstall" />
                    </div>




               </xpath>


           </field>
    </record>

    <record id="sale_order_tree" model="ir.ui.view">
           <field name="name">Pedidos.Form</field>
           <field name="model">sale.order</field>
           <field name="inherit_id" ref="sale.sale_order_tree" />
           <field name="arch" type="xml">

               <xpath expr="//field[@name='name']" position="after" >
                   <field name="name_event" />
                   <field name="place_event_id" />
               </xpath>
           </field>
    </record>


    <record id="sale_order_items_event_tree" model="ir.ui.view">
           <field name="name">sale.order.items.event.tree</field>
           <field name="model">sale.order.items.event</field>
           <field name="arch" type="xml">
               <tree>
                   <field name="order_id" />
                   <field name="name_event" />
                   <field name="is_external" optional="hide"  />
                   <field name="quantity" />
                   <field name="date_event_install" />
                   <field name="date_event_uninstall_end" />


               </tree>
           </field>
    </record>


</odoo>