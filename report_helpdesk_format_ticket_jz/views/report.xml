<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="paper_format_pos_z_report" model="report.paperformat">
        <field name="name">POS Session Report</field>
        <field name="default" eval="True" />
        <field name="format">custom</field>
        <field name="page_height">297</field>
        <field name="page_width">80</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">1</field>
        <field name="margin_bottom">1</field>
        <field name="margin_left">1</field>
        <field name="margin_right">1</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_session_z" model="ir.actions.report">
        <field name="name">Reporte Ticket</field>
        <field name="model">helpdesk.ticket</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">report_helpdesk_format_ticket_jz.report_pos_session_z</field>
        <field name="report_file">report_helpdesk_format_ticket_jz.report_pos_session_z</field>
        <field name="paperformat_id" ref="paper_format_pos_z_report"/>
        <field name="print_report_name">(object.name or 'Ticket')</field>
        <field name="binding_type">report</field>
        <field name="binding_model_id" ref="helpdesk.model_helpdesk_ticket"/>
    </record>


    <template id="report_pos_session_z">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="report_helpdesk_format_ticket_jz.pos_z_report_pdf"/>
            </t>
        </t>
    </template>


    <template id="pos_z_report_pdf">
        <div t-call="web.external_layout">
            <div class="page">
                <div class="oe_structure"/>

                <div class="sh_customer_detail" style="margin-top: 120px;">

                    <div class="sh_receipt_footer" t-if="doc.partner_id">
                        <br />
                        <t style="text-align:left;">
                            <div class="sh_customer_name" style="text-align:left;">Cliente : <t t-esc="doc.partner_id.name" /></div>
                        </t>
                        <t style="text-align:left;">
                            <div class="sh_customer_name" style="text-align:left;"> NIT/CC :
                             <t t-esc="doc.partner_id.vat" /></div>
                        </t>
                        <t style="text-align:left;">
                              <t t-if="doc.partner_id.contact_address_inline">
                                  <div class="sh_customer_address" style="text-align:left;">
                                      Direccion: <t t-esc="doc.partner_id.contact_address_inline" />
                                  </div>
                              </t>
                        </t>
                        <t style="text-align:left;">
                           <t t-if="doc.partner_id.mobile">
                              <div class="sh_customer_mobile" style="text-align:left;">Telefono : <t t-esc="doc.partner_id.mobile" /></div>
                           </t>
                        </t>
                        <t style="text-align:left;">
                           <t t-if="doc.partner_id.phone">
                              <div class="sh_customer_mobile" style="text-align:left;">Celular : <t t-esc="doc.partner_id.phone" /></div>
                           </t>
                        </t>
                        <t style="text-align:left;">
                           <t t-if="doc.partner_id.email">
                            <div class="sh_customer_mobile" style="text-align:left;">Email : <t t-esc="doc.partner_id.email" /></div>
                           </t>
                        </t>
                    </div>

                </div>


                <h2><t t-esc="doc.name" /></h2>

                <div>
                    <t t-raw="doc.description" />
                </div>




                <!--

                <img t-attf-src="/web/image?model=res.company&amp;id={{doc.company_id.id}}&amp;field=logo"
                     alt="Logo" class="pos-receipt-logo"/>



                <div class="pos-receipt-contact">

                <div t-if="doc.company_id.partner_id" t-esc="doc.company_id.partner_id.display_name" />
