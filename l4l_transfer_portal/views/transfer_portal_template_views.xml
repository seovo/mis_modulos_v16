<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="l4l_transfer_portal_document_view"
              name="Show Transfers"
              customize_show="True"
              inherit_id="portal.portal_my_home"
              priority="50">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_client_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_client_category" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/l4l_transfer_portal/static/src/img/delivery.png'"/>
                <t t-set="title">Transfer Details</t>
                <t t-set="url" t-value="'/transfer_detail'"/>
                <t t-set="text">Follow, Download Our Transfer</t>
                <t t-set="placeholder_count" t-value="'transfer_count'"/>
            </t>
        </div>
    </template>

    <template id="l4l_portal_home_menu_transfer_details"
              name="Portal Layout : Menu Of Transfer"
              inherit_id="portal.portal_breadcrumbs" priority="60">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'transfer_details_view_rec'"
                class="breadcrumb-item active">
                <a t-attf-href="/transfer_detail" aria-label="Home"
                   title="TransferDetails">
                    <span>Transfer Details</span>
                </a>
                <span>/
                    <em t-out="stock_picking.name"/>
                </span>
            </li>
            <li t-if="page_name == 'transfer_details_view'"
                class="breadcrumb-item active">
                <span>Transfer Details</span>
            </li>
        </xpath>
    </template>

    <template id="l4l_portal_transfer_details" name="Transfer Details">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Transfer</t>
            </t>
            <t t-call="portal.portal_table">
                <t t-foreach="group_transfer" t-as="transfer">
                    <thead>
                        <tr t-if="groupby in ('picking_type_id', 'partner_id', 'state')">
                            <td t-if="groupby == 'partner_id'">
                                <h5>
                                    <em class="font-weight-normal text-strong"
                                        t-out="transfer['partner_id'].display_name">
                                        <span class="text-truncate">None</span>
                                    </em>
                                </h5>
                            </td>
                            <td t-if="groupby == 'picking_type_id'">
                                <h5>
                                    <em class="font-weight-normal text-strong"
                                        t-out="transfer['picking_type_id'].name">
                                        <span class="text-truncate">Operation Type</span>
                                    </em>
                                </h5>
                            </td>
                            <td t-if="groupby == 'state'">
                                <h5>
                                    <em t-if="transfer['state'] == 'draft'">
                                        <em class="font-weight-normal text-strong">
                                            Draft
                                        </em>
                                    </em>
                                    <em t-if="transfer['state'] == 'assigned'">
                                        <em class="font-weight-normal text-strong">
                                            Ready
                                        </em>
                                    </em>
                                    <em t-if="transfer['state'] == 'done'">
                                        <em class="font-weight-normal text-strong">
                                            Done
                                        </em>
                                    </em>
                                    <em t-if="transfer['state'] == 'confirmed'">
                                        <em class="font-weight-normal text-strong">
                                            Waiting
                                        </em>
                                    </em>
                                    <em t-if="transfer['state'] == 'waiting'">
                                        <em class="font-weight-normal text-strong">
                                            Waiting Another Operation
                                        </em>
                                    </em>
                                    <em t-if="transfer['state'] == 'cancel'">
                                        <em class="font-weight-normal text-strong">
                                            Canceled
                                        </em>
                                    </em>
                                </h5>
                            </td>
                        </tr>
                        <tr class="active">
                            <th>Reference</th>
                            <th class="text-center" t-if="groupby != 'partner_id'">Contact</th>
                            <th class="text-center">Scheduled Date</th>
                            <th class="text-center">Source Document</th>
                            <th class="text-center" t-if="groupby != 'picking_type_id'">Operation Type</th>
                            <th class="text-center">Company</th>
                            <th class="text-center" t-if="groupby != 'state'">Status</th>
                        </tr>
                    </thead>
                    <t t-foreach="transfer['transfer']" t-as="record">
                        <tr>
                            <td>
                                <a t-attf-href="/transfer_detail/#{record.id}">
                                    <t t-out="record.name"/>
                                </a>
                            </td>
                            <td class="text-center" t-if="groupby != 'partner_id'">
                                <span t-field="record.partner_id.display_name"/>
                            </td>
                            <td class="text-center">
                                <span t-field="record.scheduled_date"/>
                            </td>
                            <td class="text-center">
                                <span t-field="record.origin"/>
                            </td>
                            <td class="text-center" t-if="groupby != 'picking_type_id'">
                                <span t-field="record.picking_type_id.display_name"/>
                            </td>
                            <td class="text-center">
                                <span t-field="record.company_id.display_name"/>
                            </td>
                            <td class="tx_status text-center" t-if="groupby != 'state'">
                                <t t-if="record.state == 'assigned'">
                                    <span class="badge rounded-pill text-bg-info">
                                        <i class="fa fa-fw fa-check" aria-label="Ready" title="Ready" role="img"/>
                                        <span class="d-none d-md-inline">Ready</span>
                                    </span>
                                </t>
                                <t t-if="record.state == 'done'">
                                    <span class="badge rounded-pill text-bg-success">
                                        <i class="fa fa-fw fa-check" aria-label="Done" title="Done" role="img"/>
                                        <span class="d-none d-md-inline">Done</span>
                                    </span>
                                </t>
                                <t t-if="record.state == 'confirmed'">
                                    <span class="badge rounded-pill text-bg-info">
                                        <i class="fa fa-fw fa-clock-o" aria-label="Confirmed" title="Confirmed"
                                           role="img"/>
                                        <span class="d-none d-md-inline">Waiting</span>
                                    </span>
                                </t>
                                <t t-if="record.state == 'waiting'">
                                    <span class="badge rounded-pill text-bg-info">
                                        <i class="fa fa-fw fa-clock-o" aria-label="Waiting" title="Waiting"
                                           role="img"/>
                                        <span class="d-none d-md-inline">Waiting Another Operation</span>
                                    </span>
                                </t>
                                <t t-if="record.state == 'draft'">
                                    <span class="badge rounded-pill text-bg-warning">
                                        <i class="fa fa-fw fa-clock-o" aria-label="Draft" title="Draft" role="img"/>
                                        <span class="d-none d-md-inline">Draft</span>
                                    </span>
                                </t>
                                <t t-if="record.state == 'cancel'">
                                    <span class="badge rounded-pill text-bg-danger">
                                        <i class="fa fa-fw fa-remove" aria-label="Cancelled" title="Cancelled"
                                           role="img"/>
                                        <span class="d-none d-md-inline">Cancelled</span>
                                    </span>
                                </t>
                            </td>
                        </tr>
                    </t>
                </t>
            </t>
        </t>
    </template>

    <template id="l4l_portal_transfer_record_details" inherit_id="portal.portal_sidebar">
        <xpath expr="//div[hasclass('o_portal_sidebar')]" position="inside">
            <div class="row mt16">
                <div class="col-md-3">
                    <t t-foreach="transfer_detail_rec" t-as="stock_picking">
                        <div class="pb-2 pt-3 card-header bg-white">
                            <div class="sidebar">
                                <div class="o_download_pdf btn-toolbar flex-sm-nowrap">
                                    <div class="btn-group flex-grow-1 me-1 mb-1">
                                        <a class="btn btn-secondary o_download_btn"
                                           t-attf-href="/transfer_detail/download_stock_pdf/#{stock_picking.id}"
                                           title="Download">
                                            <i class="fa fa-download"/>
                                            Download
                                        </a>
                                    </div>
                                    <div class="btn-group flex-grow-1 mb-1">
                                        <a class="btn btn-secondary o_print_btn o_portal_transfer_print"
                                           title="Print"
                                           t-attf-href="/transfer_detail/stock_pdf/#{stock_picking.id}"
                                           target="_blank">
                                            <i class="fa fa-print"/>
                                            Print
                                        </a>
                                    </div>
                                </div>
                                <div t-if="stock_picking.user_id" class="flex-grow-1">
                                    <h6>
                                        <small class="text-muted">
                                            <t t-if="stock_picking.user_id">
                                                Responsible
                                            </t>
                                        </small>
                                    </h6>
                                    <div class="o_portal_contact_details d-flex flex-column gap-2">
                                        <div class="d-flex justify-content-start align-items-center gap-2">
                                            <img class="o_avatar o_portal_contact_img rounded"
                                                 t-att-src="image_data_uri(stock_picking.user_id.avatar_128)"
                                                 alt="Contact"/>
                                            <div>
                                                <h6 class="mb-0" t-out="stock_picking.user_id.name"/>
                                                <a href="#discussion"
                                                   class="d-flex align-items-center gap-2 small fw-bold">
                                                    Send message
                                                </a>
                                            </div>
                                        </div>
                                        <div t-field="stock_picking.user_id"
                                             t-options='{"widget": "contact", "fields": ["city", "phone"]}'/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
                <div class="col-md-9">
                    <div class="card pb-5">
                        <div>
                            <t t-foreach="transfer_detail_rec" t-as="record">
                                <div class="card mb-3">
                                    <div style="background-color: #4f3a49;" class="card-header text-white">
                                        <h2 class="my-0">
                                            <em t-esc="record.name"/>
                                        </h2>
                                    </div>
                                    <br/>
                                    <div class="card-body">
                                        <div>
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <t t-if="record.partner_id">
                                                        <strong>Vendor Address:</strong>
                                                        <address t-field="record.partner_id"
                                                                 t-options='{"widget": "contact", "fields": ["street", "name", "phone", "email", "website"], "no_marker": True}'/>
                                                    </t>
                                                </div>
                                                <div class="col-md-6">
                                                    <t t-if="record.picking_type_id.warehouse_id.partner_id">
                                                        <span>
                                                            <strong>Warehouse Address:</strong>
                                                        </span>
                                                        <div t-field="record.picking_type_id.warehouse_id.partner_id"
                                                             t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}'/>
                                                    </t>
                                                </div>
                                            </div>
                                        </div>
                                        <br/>
                                        <br/>
                                        <div class="table-responsive">
                                            <table class="table table-bordered">
                                                <thead style="background-color: #4f3a49;" class="text-white">
                                                    <th class="text-center">Picking Type</th>
                                                    <th class="text-center">Source Document</th>
                                                    <th class="text-center">Status</th>
                                                    <th class="text-center">Scheduled Date</th>
                                                </thead>
                                                <br/>
                                                <tr>
                                                    <td class="text-center" id="picking_type_id">
                                                        <span t-esc="record.picking_type_id.name"/>
                                                    </td>
                                                    <td class="text-center" id="origin">
                                                        <span t-esc="record.origin"/>
                                                    </td>
                                                    <td class="text-center" id="state">
                                                        <span t-field="record.state"/>
                                                    </td>
                                                    <td class="text-center" id="scheduled_date">
                                                        <span t-esc="record.scheduled_date"/>
                                                    </td>
                                                </tr>
                                            </table>
                                        </div>
                                        <br/>
                                        <br/>
                                        <div class="table-responsive">
                                            <table class="table table-bordered">
                                                <thead style="background-color: #4f3a49;" class="text-white">
                                                    <th class="text-center">Product</th>
                                                    <th class="text-center">Description</th>
                                                    <th class="text-center">Demand</th>
                                                    <th class="text-center">Done</th>
                                                    <th class="text-center">Unit Of Measure</th>
                                                </thead>
                                                <br/>
                                                <t t-foreach="transfer_lines_detail_rec" t-as="line">
                                                    <tr>
                                                        <td class="text-center" id="product_name">
                                                            <span t-esc="line.product_id.display_name"/>
                                                        </td>
                                                        <td class="text-center" id="product_description">
                                                            <span t-esc="line.description_picking"/>
                                                        </td>
                                                        <td class="text-center" id="product_uom_qty">
                                                            <span t-esc="line.product_uom_qty"/>
                                                        </td>
                                                        <td class="text-center" id="quantity">
                                                            <span t-esc="line.quantity"/>
                                                        </td>
                                                        <td class="text-center" id="product_uom">
                                                            <span t-esc="line.product_uom.name"/>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
            </div>


            <t t-foreach="transfer_detail_rec" t-as="stock_picking">
                <div id="transfer_communication_detail" class="mt-4">

                   <!--  -->

                   <!-- modal relative to the actions sign and pay -->
                   <div role="dialog" class="modal fade" id="modalaccept">
                        <!--  t-if="sale_order._has_to_be_signed()" -->
                        <div class="modal-dialog" >
                            <form id="accept" method="POST" t-att-data-order-id="stock_picking.id"
                                  t-att-data-token="stock_picking.access_token" class="js_accept_json modal-content js_website_submit_form">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <header class="modal-header">
                                    <h4 class="modal-title">Firmar</h4>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </header>
                                <main class="modal-body" id="sign-dialog">
                                    <!--
                                    <p>
                                        <span>By signing this proposal, I agree to the following terms:</span>
                                        <ul>
                                            <li>
                                                <span>Accepted on the behalf of:</span> <b t-field="sale_order.partner_id.commercial_partner_id"/>
                                            </li>
                                            <li>
                                                <span>For an amount of:</span> <b data-id="total_amount" t-field="sale_order.amount_total"/>
                                            </li>
                                            <li t-if="sale_order.payment_term_id">
                                                <span>With payment terms:</span> <b t-field="sale_order.payment_term_id.note"/>
                                            </li>
                                        </ul>
                                    </p>
                                    -->
                                    <t t-call="portal.signature_form">
                                        <t t-set="call_url" t-value="stock_picking.get_portal_url(suffix='/accept')"/>
                                        <t t-set="default_name" t-value=" "/>
                                    </t>
                                </main>
                            </form>
                        </div>
                    </div>

                   <!-- bottom actions -->
                   <!--  t-if="sale_order._has_to_be_signed() or sale_order._has_to_be_paid()" -->
                   <div
                         class="d-flex justify-content-center gap-1 d-print-none" t-if="not stock_picking.signature">


                        <t >
                            <div class="col-sm-auto mt8">
                                <a role="button" class="btn btn-primary" data-bs-toggle="modal"
                                   data-bs-target="#modalaccept" href="#"><i class="fa fa-check"/>
                                    Firmar
                                </a>
                            </div>
                            <div class="col-sm-auto mt8">
                                <a role="button" class="btn btn-secondary" href="#discussion"><i class="fa fa-comment"/> Opinión</a>
                            </div>

                            <!--

                            <div class="col-sm-auto mt8">
                                <a role="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#modaldecline" href="#">
                                    <i class="fa fa-times"/> Reject</a>
                            </div>

                            -->


                        </t>
                        <!--
                        <div t-elif="sale_order._has_to_be_paid()" class="col-sm-auto mt8">
                            <a role="button" data-bs-toggle="modal" data-bs-target="#modalaccept" href="#" t-att-class="'%s' % ('btn btn-light' if sale_order.transaction_ids else 'btn btn-primary')">
                                <i class="fa fa-check"/> <t t-if="not sale_order.signature">Accept &amp; Pay</t><t t-else="">Pay Now</t>
                            </a>
                        </div>
                        -->
                    </div>

                    <h2>History</h2>
                    <t t-call="portal.message_thread">
                        <t t-set="object" t-value="stock_picking"/>
                    </t>
                </div>
            </t>
        </xpath>
    </template>
</odoo>