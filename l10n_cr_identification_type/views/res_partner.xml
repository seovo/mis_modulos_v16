<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
		<record id="partner_identification_id" model="ir.ui.view">
			<field name="name">partner.document.types</field>
			<field name="model">res.partner</field>
			<field name="inherit_id" ref="base.view_partner_form" />
			<field name="arch" type="xml">

				<xpath expr='//field[@name="vat"]' position='after'>
						<field name="identification_id" />
				</xpath>

				<field name="zip" position="attributes">
					<attribute name="required">False</attribute>
				</field>

				<field name="city" position="attributes">
					<attribute name="required">False</attribute>
				</field>

			</field>
		</record>

		<record id="l10n_latam_invoice_document.view_document_type_form" model="ir.ui.view">
			<field name="name">l10n_latam.document.type</field>
			<field name="model">l10n_latam.document.type</field>
			<field name="arch" type="xml">
				<form string="Document Type" >
                   <group>
                    <field name="code"/>
                    <field name="name"/>
                    <field name="doc_code_prefix"/>
                    <field name="report_name"/>
                    <field name="internal_type"/>
                    <field name="country_id"/>
                </group>
                </form>
			</field>

		</record>



	</data>
</odoo>
