<?xml version="1.0" encoding="utf-8"?>
<odoo >
    <record id="Identificationtype_01" model="l10n_latam.document.type">
        <field name="code">01</field>
        <field name="name">Cédula física</field>
        <field name="doc_code_prefix">CRCPF</field>
        <field name="report_name">CRCPF</field>
        <field name='country_id' ref='base.cr'  />
        <field name="notes">Se agrega tres ceros antes de iniciar con el número de cédula para completar 12 dígitos
        </field>
    </record>

    <record id="Identificationtype_02" model="l10n_latam.document.type">
        <field name="code">02</field>
        <field name="name">Cédula jurídica</field>
        <field name="doc_code_prefix">CPJ</field>
        <field name="report_name">CPJ</field>
        <field name='country_id' ref='base.cr'  />
        <field name="notes">Se debe agregar dos ceros antes de iniciar con el número de cédula para completar 12
            dígitos
        </field>
    </record>

    <record id="Identificationtype_03" model="l10n_latam.document.type">
        <field name="code">03</field>
        <field name="name">DIMEX</field>
        <field name="doc_code_prefix">DIMEX</field>
        <field name="report_name">DIMEX</field>
        <field name='country_id' ref='base.cr'  />
        <field name="notes">En aquellos casos donde la cédula se encuentre compuesta de 11 dígitos se debe agregar un
            cero al inicio para completar 12 dígitos
        </field>
    </record>

    <record id="Identificationtype_04" model="l10n_latam.document.type">
        <field name="code">04</field>
        <field name="name">NITE</field>
        <field name="doc_code_prefix">DIMEX</field>
        <field name="report_name">DIMEX</field>
        <field name='country_id' ref='base.cr'  />
        <field name="notes">Se debe agregar dos ceros antes de iniciar con el número de identificación para completar 12
            dígitos
        </field>
    </record>

    <record id="Identificationtype_05" model="l10n_latam.document.type">
        <field name="code">05</field>
        <field name="name">Extranjero</field>
        <field name="doc_code_prefix">PPN</field>
        <field name="report_name">PPN</field>
        <field name='country_id' ref='base.cr'  />
        <field name="notes">Número de identificación en caso de que el receptor sea un extranjero. Máximo 20
            caracteres
        </field>
    </record>

    <record id="Identificationtype_08" model="l10n_latam.document.type">
        <field name="code">08</field>
        <field name="name">Otros</field>
        <field name="doc_code_prefix">OTR</field>
        <field name="report_name">OTR</field>
        <field name='country_id' ref='base.cr'  />
        <field name="notes">Identificación para otros casos específicos. Máximo 20 caracteres.
        </field>
    </record>
</odoo>
