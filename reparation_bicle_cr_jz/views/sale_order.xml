<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_form" model="ir.ui.view">
           <field name="name">sale.order.Form</field>
           <field name="model">sale.order</field>
           <field name="inherit_id" ref="sale.view_order_form" />
           <field name="arch" type="xml">
               <xpath expr="//field[@name='partner_shipping_id']" position="after" >
                   <field name="product_repair_id" />
                   <field name="cat_bycle_id" />
                   <field name="under_warranty_bycle" />

               </xpath>
               <xpath expr="//header/button[id='send_by_email']" position="replace" >
                   <button name="action_quotation_send" id="send_by_email" string="Enviar Whatsapp"
                           type="object" invisible="state not in ('sent', 'sale')"
                          />

               </xpath>

           </field>
    </record>


</odoo>