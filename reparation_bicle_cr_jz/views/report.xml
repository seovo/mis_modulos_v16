<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_project" model="ir.actions.report">
        <field name="name">Detalle</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">report_project_clinicosas_jz.report_project</field>
        <field name="report_file">report_project_clinicosas_jz.report_project</field>
       <!-- <field name="paperformat_id" ref="paper_format_pos_z_report"/> -->
        <field name="print_report_name">(object.name or 'Detalle')</field>
        <field name="binding_type">report</field>
        <field name="binding_model_id" ref="project.model_sale_order"/>
    </record>

    <template id="report_project">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="report_project_clinicosas_jz.report_project_template"/>
            </t>
        </t>
    </template>


    <template id="report_project_template">
        <div t-call="web.external_layout">

            <t t-set="address">
               <div t-field="doc.partner_id"
                t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}' />
               <p t-if="doc.partner_id.vat">
                <t t-if="doc.company_id.account_fiscal_country_id.vat_label" t-out="doc.company_id.account_fiscal_country_id.vat_label"/>
                <t t-else="">Tax ID</t>: <span t-field="doc.partner_id.vat"/>
            </p>
            </t>


            <div class="page">
                <div class="oe_structure"/>

                <h2 class="mt-4">
                    <span t-field="doc.display_name" />
                </h2>

                <div class="row mt-4 mb-2" id="informations">

                    <div t-if="doc.user_id" class="col-auto col-3 mw-100 mb-2">
                        <strong>Mecanico:</strong><br/>
                        <span class="m-0" t-field="doc.user_id"></span>
                    </div>


                    <div t-if="doc.date_order" class="col-auto col-3 mw-100 mb-2" name="informations_date">
                       <strong>Fecha de Orden:</strong><br/>
                       <span class="m-0" t-field="doc.date_order" t-options='{"widget": "date"}'></span>
                    </div>



                </div>


                <table class="table table-sm o_main_table table-borderless mt-4">
                    <!-- In case we want to repeat the header, remove "display: table-row-group" -->
                    <thead style="display: table-row-group">
                       <tr>
                          <th name="th_description" class="text-start">Descripción</th>
                          <!--<th name="th_quantity" class="text-end">Imagen</th>-->
                       </tr>

                    </thead>

                    <tbody class="sale_tbody">

                        <t t-foreach="doc.tasks" t-as="line">

                            <tr class="bg-200 fw-bold o_line_section">
                                <td name="td_section_line" colspan="99">
                                      <span t-field="line.name"></span>
                                </td>
                             </tr>



                        </t>



                    </tbody>

                </table>



            </div>
        </div>
    </template>

</odoo>