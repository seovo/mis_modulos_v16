<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_tareas" model="ir.actions.act_window">
            <field name="name">Tareas</field>
            <field name="res_model">line.repair.order</field>
            <field name="view_mode">tree,form,kanban</field>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                No repair order found. Let's create one!
              </p><p>
                In a repair order, you can detail the components you remove,
                add or replace and record the time you spent on the different
                operations.
              </p>
            </field>
    </record>


    <record id="line_repair_order_form" model="ir.ui.view">
        <field name="name">line.repair.order.form</field>
        <field name="model">line.repair.order</field>
        <field name="arch" type="xml">
            <form string="Repair Order">


               <sheet string="Repairs order">

                    <div class="oe_title">
                        <label class="o_form_label" for="name"/>
                        <h1 class="d-flex">

                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="repair_id" />
                            <field name="product_id" />
                            <field name="code" />

                        </group>
                        <group>
                            <field name="product_ids" widget="many2many_tags" />

                        </group>
                    </group>

                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>


    <menuitem id="repair_tareas_menu" name="Tareas" action="action_tareas"

              parent="repair.menu_repair_order"/>
</odoo>