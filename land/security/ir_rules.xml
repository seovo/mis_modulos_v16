<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Multi - Company Rules -->
    <record id="sale_order_land_zona_rule" model="ir.rule">
        <field name="name">ZONA multi-company</field>
        <field name="model_id" ref="model_land_zona"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>



    <record id="seller_land_rule" model="ir.rule">
        <field name="name">SELLER multi-company</field>
        <field name="model_id" ref="model_seller_land"/>
        <field name="domain_force">['|',('company_id', 'in', company_ids),('company_id.parent_id', 'in', company_ids)]</field>
    </record>


    <!-- MULTI COMPANY REPORTE CRONOGRAMA -->
    <record id="schedule_dues_land_rule" model="ir.rule">
        <field name="name">schedule multi-company</field>
        <field name="model_id" ref="model_schedule_dues_land"/>
        <field name="domain_force">[('order_id.company_id', 'in', company_ids)]</field>
    </record>




</odoo>
