<odoo>


    <record model="ir.ui.view" id="schedule_dues_land_search" >
        <field name="name">schedule.dues.land.search</field>
        <field name="model">schedule.dues.land</field>
        <field name="arch" type="xml">
            <search>
                <filter name="show_cuotas" string="Cuotas" domain="[('number_due', '>=', 0)]" />
                <filter name="show_advanced" string="Iniciales - Adelantos" domain="[('number_due', '=', 0)]" />
                <!--<filter name="show_separated" string="Separados" domain="[('state', '=', 'reserved')]" /> -->
                <field name="nro_internal_land" />
                <field name="order_id" />
                <field name="line_move_id" />
                <group string="Group By..." expand="0" name="groupby">
                    <filter string="Expediente" name="gr_nro_internal_land" context="{'group_by': 'nro_internal_land'}"/>
                    <filter string="Venta" name="gr_order_id" context="{'group_by': 'order_id'}"/>
                    <filter string="Expediente - Venta" name="gr_order_identificador" context="{'group_by': 'order_identificador'}"/>



                </group>
            </search>
        </field>
    </record>

    <record model="ir.ui.view" id="schedule_dues_land_tree" >
        <field name="name">schedule.dues.land.tree</field>
        <field name="model">schedule.dues.land</field>
        <field name="arch" type="xml">
            <tree string="Sales"
                  decoration-danger="is_paid == False"
                  decoration-success="is_paid == True"
                  delete="false"
                  >

                <!-- create="false"
                  delete="false"
                  readonly="1"
                  editable="bottom" -->

                <field name="description" readonly="1"  />

                <field name="number_due" readonly="1" optional="hidden" />
                <field name="type_number_schedule" readonly="1" optional="hidden" />
                <!--
                <button name="invoice_here_land" string="Pagar"
                                            groups="land.group_payment_cronograma"
                                            type="object"  />
                -->
                <field name="date" readonly="1" />

                <field name="balan" readonly="1"  />
                <field name="amount" readonly="1"   />

                <field name="is_paid" readonly="1"   />
                <field name="move_id"  optional="show" />
                <field name="invoice_date" optional="show" readonly="1"  />

                <field name="amount_due_land"  />
                <field name="amount_mora_land"  optional="hidden" />

                <field name="line_move_id"  optional="hide" />

            </tree>
        </field>
    </record>

    <record id="action_schedule_dues_land" model="ir.actions.act_window">
        <field name="name">Reporte de Cuotas</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">schedule.dues.land</field>
        <field name="view_mode">tree</field>
        <field name="context">
            {
               'search_default_gr_order_identificador' : 1
            }
        </field>


    </record>

    <menuitem action="action_schedule_dues_land"
              id="menu_schedule_dues_land"
              parent="sale.menu_sale_report"
              sequence="102"
    />

</odoo>
