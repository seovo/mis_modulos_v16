<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_seller_land" model="ir.actions.act_window">
        <field name="name">Proveedor Terreno</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">seller.land</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem action="action_seller_land"
              id="menu_seller_land"
              parent="sale.menu_sale_config" />



    <record id="action_land_zona" model="ir.actions.act_window">
        <field name="name">Tipo de Ubicacion</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">land.zona</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record model="ir.ui.view" id="land_zona_tree" >
        <field name="name">land.zona.tree</field>
        <field name="model">land.zona</field>
        <field name="arch" type="xml">
            <tree >
                <field name="name" />
                <field name="value" />
                <field name="company_id" />
            </tree>
        </field>
    </record>

    <menuitem action="action_land_zona"
              id="menu_land_zona"
              parent="sale.menu_sale_config" />


</odoo>