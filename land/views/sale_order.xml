    <record id="view_order_tree_report" model="ir.ui.view">
           <field name="name">sale.order.Form</field>
           <field name="model">sale.order</field>
           <field name="arch" type="xml">
               <tree string="Ventas"
                                      decoration-danger="mounth_expired_land >= 3"
                                       decoration-warning="mounth_expired_land >= 2"
                                >
                   <field name="nro_internal_land" optional="show" />
                   <field name="mz_lot" />
                   <field name="partner_id"   optional="hidden" />
                   <field name="last_payment_date_land"  optional="hidden" />


                   <field name="next_payment_date_land" optional="show" />
                   <field name="last_date_to_pay_land"  optional="show" />
                   <field name="mounth_expired_land"  optional="show" />
                   <field name="days_expired_land" optional="show" />
                   <field name="mora_acumulada" optional="hidden" />

                   <!--<field name="name" optional="hiden" /> -->
                   <field name="seller_land_id" optional="hidden" />


                   <field name="stage_land" widget="badge" optional="show" />
                   <field name="stage_payment_lan" widget="badge" decoration-success="stage_payment_lan == 'payment'" optional="show" />
                   <field name="state" optional="hidden" />


                   <field name="dues_land" optional="show" />
                   <field name="qty_dues_payment" optional="show" />

                   <field name="total_dues_independence"  optional="show" />
                   <field name="qty_dues_independence_payment"  optional="show" />

                   <field name="value_due_land" optional="show" />
                   <field name="credit_year_now"  optional="hidden"  />
                   <button name="show_dues_land" string="Pagos" type="object" />


                   <field name="paid_land_1" optional="hidden"  decoration-success="paid_land_1 > 0"  decoration-danger="paid_land_1 * -1 > 0" />
                   <field name="paid_land_2" optional="hidden"  decoration-success="paid_land_2 > 0"  decoration-danger="paid_land_3 * -1 > 0" />
                   <field name="paid_land_3" optional="hidden"  decoration-success="paid_land_3 > 0"  decoration-danger="paid_land_3 * -1 > 0" />
                   <field name="paid_land_4" optional="hidden"  decoration-success="paid_land_4 > 0"  decoration-danger="paid_land_4 * -1 > 0"  />
                   <field name="paid_land_5" optional="hidden"  decoration-success="paid_land_5 > 0"  decoration-danger="paid_land_5 * -1 > 0"  />
                   <field name="paid_land_6" optional="hidden"  decoration-success="paid_land_6 > 0"  decoration-danger="paid_land_6 * -1 > 0"  />
                   <field name="paid_land_7" optional="hidden"  decoration-success="paid_land_7 > 0"  decoration-danger="paid_land_7 * -1 > 0"  />
                   <field name="paid_land_8" optional="hidden"  decoration-success="paid_land_8 > 0"  decoration-danger="paid_land_8 * -1 > 0"  />
                   <field name="paid_land_9" optional="hidden"  decoration-success="paid_land_9 > 0"  decoration-danger="paid_land_9 * -1 > 0"  />
                   <field name="paid_land_10" optional="hidden"  decoration-success="paid_land_10 > 0"  decoration-danger="paid_land_10 * -1 > 0"  />
                   <field name="paid_land_11" optional="hidden"  decoration-success="paid_land_11 > 0"  decoration-danger="paid_land_11 * -1 > 0"  />
                   <field name="paid_land_12" optional="hidden"  decoration-success="paid_land_12 > 0"  decoration-danger="paid_land_12 * -1 > 0"  />
                   <field name="amount_total"  optional="hidden" />


                   <field name="price_initial_land" string="Inicial"  optional="hidden" />
                   <field name="price_credit_land" string="Credito" optional="show"  />
                   <field name="total_payment_land" string="Abonado" optional="show"  />
                   <field name="saldo_payment_land"  string="Saldo" optional="show"  />

                   <field name="price_independence_land"   readonly="1" force_save="1"  optional="show" />
                   <field name="total_independence_land"   readonly="1" force_save="1"    optional="show"  />
                   <field name="saldo_independence_land"   readonly="1" force_save="1"   optional="show"  />


                   <field name="state_lawyer_land"  optional="hidden" />
                   <field name="obs_resolution"  optional="hidden" />


                   <field name="payment_year_now"  optional="hidden" />
                   <field name="saldo_year_now"   optional="hidden"  />

               </tree>
           </field>
    </record>


