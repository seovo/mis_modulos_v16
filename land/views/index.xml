<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="index_form_adjunto" name="Form Index">
<html>
    <head>
        <title>Sube tu Comprobante</title>

        <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1"/>
        <meta http-equiv="content-type" content="text/html, charset=utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no"/>
        <meta name="apple-mobile-web-app-capable" content="yes"/>
        <meta name="mobile-web-app-capable" content="yes"/>
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/css/bootstrap.min.css" integrity="sha384-Gn5384xqQ1aoWXA+058RXPxPg6fy4IWvTNh0E263XmFcJlSAwiGgFAW/dAiS6JXm" crossorigin="anonymous"/>



        <style>
            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                padding: 0;
                min-height: 100vh;
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 20px;
            }

            .card-form {
                background: #ffffff;
                border-radius: 20px;
                box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
                padding: 40px 45px;
                width: 100%;
                max-width: 620px;
            }

            .card-form h2 {
                color: #333;
                font-weight: 700;
                margin-bottom: 8px;
                text-align: center;
            }

            .card-form .subtitle {
                color: #777;
                text-align: center;
                margin-bottom: 30px;
                font-size: 15px;
            }

            .card-form label {
                font-weight: 600;
                color: #444;
                margin-bottom: 6px;
                display: block;
            }

            .card-form .form-control-lg,
            .card-form .form-select-lg {
                border-radius: 10px;
                border: 2px solid #e0e0e0;
                padding: 14px 18px;
                font-size: 17px;
                transition: border-color 0.3s, box-shadow 0.3s;
            }

            .card-form .form-control-lg:focus,
            .card-form .form-select-lg:focus {
                border-color: #667eea;
                box-shadow: 0 0 0 4px rgba(102, 126, 234, 0.15);
                outline: none;
            }

            .card-form .form-group {
                margin-bottom: 22px;
            }

            .card-form .file-upload {
                position: relative;
                border: 2px dashed #c0c0c0;
                border-radius: 10px;
                padding: 30px 20px;
                text-align: center;
                cursor: pointer;
                transition: border-color 0.3s, background 0.3s;
                background: #fafafa;
            }

            .card-form .file-upload:hover {
                border-color: #667eea;
                background: #f5f7ff;
            }

            .card-form .file-upload input[type="file"] {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                opacity: 0;
                cursor: pointer;
            }

            .card-form .file-upload .upload-icon {
                font-size: 42px;
                display: block;
                margin-bottom: 10px;
            }

            .card-form .file-upload .upload-text {
                font-size: 16px;
                color: #666;
                font-weight: 500;
            }

            .card-form .file-upload .upload-text small {
                display: block;
                color: #999;
                font-weight: 400;
                margin-top: 4px;
            }

            /* Zona de carga con archivo seleccionado */
            .card-form .file-upload.has-file {
                border-style: solid;
                border-color: #667eea;
                background: #f5f7ff;
            }

            .card-form .file-upload.has-file .upload-icon {
                display: none;
            }

            .card-form .file-upload.has-file .upload-text {
                display: none;
            }

            .card-form .file-preview {
                display: flex;
                flex-direction: column;
                align-items: center;
                gap: 10px;
            }

            .card-form .file-preview img {
                max-width: 180px;
                max-height: 140px;
                border-radius: 10px;
                border: 2px solid #e0e0e0;
                object-fit: contain;
                background: #fff;
            }

            .card-form .file-preview .file-name {
                font-size: 14px;
                font-weight: 600;
                color: #667eea;
                word-break: break-all;
                max-width: 100%;
            }

            .card-form .file-preview .file-name::before {
                content: '✅ ';
            }

            .card-form .btn-submit {
                width: 100%;
                padding: 16px;
                font-size: 18px;
                font-weight: 700;
                border-radius: 10px;
                border: none;
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                color: #fff;
                cursor: pointer;
                transition: transform 0.2s, box-shadow 0.2s;
                margin-top: 10px;
            }

            .card-form .btn-submit:hover {
                transform: translateY(-2px);
                box-shadow: 0 10px 25px rgba(102, 126, 234, 0.4);
            }

            .card-form .btn-submit:active {
                transform: translateY(0);
            }

            .card-form .icon-field {
                position: relative;
            }

            .card-form .icon-field .form-control-lg,
            .card-form .icon-field .form-select-lg {
                padding-left: 48px;
            }

            .card-form .icon-field .field-icon {
                position: absolute;
                left: 16px;
                top: 50%;
                transform: translateY(-50%);
                font-size: 20px;
                color: #999;
                pointer-events: none;
            }

            /* Checkboxes de lotes */
            .card-form .checkbox-lote {
                display: flex;
                align-items: center;
                padding: 12px 16px;
                margin-bottom: 8px;
                border: 2px solid #e0e0e0;
                border-radius: 10px;
                background: #fafafa;
                cursor: pointer;
                transition: border-color 0.3s, background 0.3s;
            }

            .card-form .checkbox-lote:hover {
                border-color: #667eea;
                background: #f5f7ff;
            }

            .card-form .checkbox-lote input[type="checkbox"] {
                width: 22px;
                height: 22px;
                margin-right: 12px;
                cursor: pointer;
                accent-color: #667eea;
            }

            .card-form .checkbox-lote .lote-text {
                font-size: 16px;
                font-weight: 500;
                color: #444;
            }

            /* Grid nativo (sin Bootstrap) para campos lado a lado */
            .card-form .row {
                display: flex;
                flex-wrap: wrap;
                margin-left: -10px;
                margin-right: -10px;
            }

            .card-form .row > [class*="col-"] {
                padding-left: 10px;
                padding-right: 10px;
            }

            .card-form .col-md-6 {
                flex: 0 0 50%;
                max-width: 50%;
            }

            @media (max-width: 576px) {
                .card-form {
                    padding: 25px 20px;
                }

                .card-form .col-md-6 {
                    flex: 0 0 100%;
                    max-width: 100%;
                }
            }
        </style>
    </head>
    <body>
        <div class="card-form">
            <h2>📄 Sube tu Comprobante</h2>
            <p class="subtitle">Completa tus datos y adjunta tu imagen</p>

            <form method="POST" action="/api/up/land" enctype="multipart/form-data">
                <div class="row">

                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="tipo_identificacion">Tipo de Identificación</label>
                            <div class="icon-field">
                                <span class="field-icon">🏷️</span>
                                <select id="tipo_identificacion" name="tipo_identificacion" class="form-select form-select-lg">
                                    <option value="1">DNI</option>
                                    <option value="6">RUC</option>
                                    <option value="4">Cédula Extranjera</option>
                                    <option value="7">Pasaporte</option>
                                    <option value="H">Carné Permiso Temp. Perman.</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="vat">Número de Identificación</label>
                            <div class="icon-field">
                                <span class="field-icon">🪪</span>
                                <input type="text" id="vat" name="vat" class="form-control form-control-lg" required="required" placeholder="DNI, RUC, CE, etc."/>
                            </div>
                        </div>
                    </div>

                </div>

                <div class="form-group">
                    <label for="nombres_apellidos">Nombres y Apellidos</label>
                    <div class="icon-field">
                        <span class="field-icon">👤</span>
                        <input type="text" id="nombres_apellidos" name="nombres_apellidos" class="form-control form-control-lg" required="required" placeholder="Nombres y Apellidos"/>
                    </div>
                </div>

                <div class="form-group" id="lotes_group" style="display:none;">
                    <label>Lotes (selecciona uno o varios)</label>
                    <div id="lotes_container"></div>
                </div>

                <!-- Campos para cliente nuevo: proyecto, MZ y LT (visibles solo si no hay lotes) -->
                <div class="form-group" id="proyecto_group" style="display:none;">
                    <label for="proyecto">Proyecto</label>
                    <div class="icon-field">
                        <span class="field-icon">🏢</span>
                        <select id="proyecto" name="proyecto" class="form-select form-select-lg">
                            <option value="">Seleccione un proyecto</option>
                            <t t-foreach="companys" t-as="comp">
                                <option t-att-value="comp['id']" t-esc="comp['name']"/>
                            </t>
                        </select>
                    </div>
                </div>

                <div class="row" id="mz_lt_group" style="display:none;">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="mz">MZ</label>
                            <div class="icon-field">
                                <span class="field-icon">📍</span>
                                <input type="text" id="mz" name="mz" class="form-control form-control-lg" placeholder="Manzana"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="lt">LT</label>
                            <div class="icon-field">
                                <span class="field-icon">🔢</span>
                                <input type="text" id="lt" name="lt" class="form-control form-control-lg" placeholder="Lote"/>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label for="celular">Celular</label>
                    <div class="icon-field">
                        <span class="field-icon">📱</span>
                        <input type="tel" id="celular" name="celular" class="form-control form-control-lg" placeholder="999 999 999"/>
                    </div>
                </div>

                <div class="form-group">
                    <label for="correo">Correo</label>
                    <div class="icon-field">
                        <span class="field-icon">✉️</span>
                        <input type="email" id="correo" name="correo" class="form-control form-control-lg" placeholder="correo@ejemplo.com"/>
                    </div>
                </div>

                <div class="form-group">
                    <label for="celular">Dirección</label>
                    <div class="icon-field">
                        <span class="field-icon">📱</span>
                        <input type="tel" id="street" name="street" class="form-control form-control-lg"
                               placeholder="Si ya registro direccion se usara la existente."/>
                    </div>
                </div>

                <div class="form-group">
                    <label for="adjunto">Adjunto (Imagen)</label>
                    <div class="file-upload" id="file_upload_zone">
                        <span class="upload-icon">🖼️</span>
                        <span class="upload-text" id="upload_text">
                            Haz clic para seleccionar una imagen
                            <small>JPG, PNG, GIF — Máx. 10 MB</small>
                        </span>
                        <input type="file" id="adjunto" name="adjunto" accept="image/*" required="required"/>

                        <!-- Vista previa / estado de archivo cargado -->
                        <div class="file-preview" id="file_preview" style="display:none;">
                            <img id="file_preview_img" src="" alt="Vista previa"/>
                            <span class="file-name" id="file_name"></span>
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn-submit">Enviar Comprobante</button>
            </form>
        </div>

        <script src="/land/static/src/js/index_form.js"></script>
    </body>
</html>
</template>

</odoo>