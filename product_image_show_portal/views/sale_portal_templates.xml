<?xml version="1.0"?>
<odoo>
    <data>
        <template id="sale_order_portal_content_inherit_image_custom" inherit_id="sale.sale_order_portal_content">
            <xpath expr="//th[@id='product_name_header']" position="before">
                <th class="text-start" id="product_image_header">Image</th>
            </xpath>
            <xpath expr="//td[@id='product_name']" position="before">
                <td class="text-start" id="product_image_custom">
                    <t t-if="line.product_id.image_128">
                        <img t-att-src="'data:image/png;base64,%s' % (line.product_id.image_128.decode('utf-8') if line.product_id.image_128 else '')" class="product-image" alt="Product Image"/>
                    </t>
                </td>
            </xpath>
        </template>
    </data>
</odoo>
