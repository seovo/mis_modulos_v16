<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_municipality" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.municipality</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="0"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- Usamos <form> como punto de inserción genérico -->
            <xpath expr="//form" position="inside">
                <div class="app_settings_block" data-string="Municipalidad" string="Municipalidad" data-key="l10n_cr_municipality">
                    <h2>Configuraciones de Municipalidad</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="content-group mt16">
                                <group>
                                    <field name="base_salary"/>
                                    <field name="ntcs"/>
                                    <field name="vncs"/>
                                    <field name="atcs"/>
                                    <field name="payment_in_advance_discount"/>
                                    <field name="advance_account_id"/>
                                </group>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
