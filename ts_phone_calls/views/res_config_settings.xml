<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">Phone Call Settings</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="45"/>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <!--                <xpath expr="//form" position="inside">-->
                <!--                    <div class="app_settings_block icon d-none d-md-block" data-string="Phone" string="Phone Calls"-->
                <!--                         data-key="ts_phone_calls"-->
                <!--                         groups="ts_phone_calls.phone_call_manager_access"-->
                <!--                         style="background : url('/ts_phone_calls/static/description/icon.png') no-repeat center; height:25px; background-size:contain;">-->
                <xpath expr="//form" position="inside">
                    <app data-string="Employees" string="ts_phone_calls" name="ts_phone_calls"
                         groups="ts_phone_calls.phone_call_manager_access">
                        <!--                     <div class="app_settings_block icon d-none d-md-block" data-string="Phone" string="Phone Calls"-->
                        <!--                         data-key="ts_phone_calls"-->
                        <!--                         style="background : url('/ts_phone_calls/static/description/icon.png') no-repeat center; height:25px; background-size:contain;">-->
                        <h2>Phone Calls</h2>
                        <div class="row mt16 o_settings_container">
                            <div class="demo_res_setting">
                            </div>
                        </div>
                        <!--                    </div>-->
                    </app>
                </xpath>

            </field>
        </record>
        <record id="phone_call_action_settings_form" model="ir.actions.act_window">
            <field name="name">Settings</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.config.settings</field>
            <field name="view_mode">form</field>
            <field name="target">current</field>
            <field name="context">{'module' : 'ts_phone_calls'}</field>
        </record>

        <menuitem id="menu_phone_calls_setting" name="Settings" action="phone_call_action_settings_form"
                  parent="ts_phone_calls.calls_config_menu" sequence="3"/>
    </data>
</odoo>
