<odoo>
    <!-- 1. Keep the standard category for organizational grouping -->
    <record model="ir.module.category" id="phone_calls_security_groups">
        <field name="name">Phone Calls</field>
        <field name="description">User access levels for Phone Calls Module</field>
        <field name="sequence">10</field>
    </record>

    <!-- 2. Create an Odoo 19 Privilege mapped to that category -->
    <record model="res.groups.privilege" id="phone_calls_privilege">
        <field name="name">Phone Calls Rights</field>
        <field name="category_id" ref="phone_calls_security_groups"/>
    </record>

    <!-- 3. Define your groups and link them via privilege_id -->
    <record id="phone_call_user_access" model="res.groups">
        <field name="name">Phone Call User</field>
        <field name="privilege_id" ref="phone_calls_privilege"/>
    </record>

    <record id="phone_call_manager_access" model="res.groups">
        <field name="name">Phone Call Manager</field>
        <field name="privilege_id" ref="phone_calls_privilege"/>
        <field name="implied_ids" eval="[(4, ref('phone_call_user_access'))]"/>
    </record>
</odoo>
