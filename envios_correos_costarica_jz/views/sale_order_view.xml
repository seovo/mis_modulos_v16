<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="sale_order_view_form_inherit_l10n_co_wh" model="ir.ui.view">
        <field name="name">l10n_co_wh.sale_order.view_form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_confirm'][2]" position="after">
                <button name="generate_guia" type="object" string="Envio Costa Rica"  />
            </xpath>

            <notebook position="inside">
                <page string="Correo Costa Rica"  >
                    <group>
                        <field name="has_send_guia_cr" />
                        <field name="pdf_guia_costarica" filename="name_pdf_guia_costarica" />
                        <field name="name_pdf_guia_costarica" invisible="1" />
                    </group>

                    <field name="log_costarica" />
                </page>
            </notebook>
        </field>
    </record>

</odoo>