<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="delivery_carrier_form" model="ir.ui.view">
            <field name="name">delivery.carrier.form</field>
            <field name="model">delivery.carrier</field>
            <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <field name="product_id"  position="after">
                    <field name="is_correo_costarica" />
                    <field name="username_costarica" invisible="not is_correo_costarica" required="is_correo_costarica" />
                    <field name="password_costarica" invisible="not is_correo_costarica" required="is_correo_costarica"  />
                    <field name="sistema_costarica" invisible="not is_correo_costarica"  required="is_correo_costarica" />
                    <field name="cod_cliente_costarica" invisible="not is_correo_costarica"  required="is_correo_costarica" />
                    <field name="usuario_id_costarica" invisible="not is_correo_costarica"  required="is_correo_costarica" />
                    <field name="servicio_costarica" invisible="not is_correo_costarica"  required="is_correo_costarica" />
                    <field name="url_token" invisible="not is_correo_costarica"  required="is_correo_costarica" />
                    <field name="url_soap" invisible="not is_correo_costarica"  required="is_correo_costarica" />

                </field>

            </field>
        </record>
    </data>






</odoo>