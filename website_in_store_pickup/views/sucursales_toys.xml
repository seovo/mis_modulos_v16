<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="action_envios_sucursales" model="ir.actions.act_window">
        <field name="name">Envios Sucursales</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sucursales.toys</field>
        <field name="view_mode">tree,form</field>

    </record>


    <record id="form_sucursales_toys" model="ir.ui.view">
        <field name="name">sucursales.toys.form</field>
        <field name="model">sucursales.toys</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="user_notify_ids"  widget="many2many_tags"  />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <menuitem action="action_envios_sucursales" id="menu_envios_sucursales"
              parent="website_sale.menu_ecommerce_settings"/>
</odoo>