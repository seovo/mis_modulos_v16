<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- This template renders a dropdown with store options based on availability.-->
    <t t-name="StorePickup">
        <t t-if="store_all">

            <select   class="store-pickup-dropdown form-select form-select-lg mb-3 mt-2 font-weight-bold">

                <option>Seleccione...</option>

                <t t-foreach="store_all" t-as="store" t-key="store_index">
                    <t t-if="store.id != warehouse_id" >
                        <option t-att-data-store-id="store.id"   t-att-value="store.id"  ><t t-out="store.name"/></option>
                    </t>
                    <t  t-else="">
                        <option t-att-data-store-id="store.id"   t-att-value="store.id" selected="1"  ><t t-out="store.name"/> </option>
                    </t>

                </t>


            </select>

        </t>
        <t t-elif="stores">
            <select class="store-pickup-dropdown card p-3 my-2">


                <option value="0">Seleccione...</option>

                <t t-foreach="stores" t-as="store" t-key="store_index">
                    <t t-if="store.id != warehouse_id" >
                        <option t-att-data-store-id="store.id"   t-att-value="store.id"  ><t t-out="store.name"/></option>
                    </t>

                    <t  t-else="" >
                        <option t-att-data-store-id="store.id"   t-att-value="store.id" selected="1"  ><t t-out="store.name"/> </option>
                    </t>

                </t>
            </select>

        </t>
    </t>
    <!--This template displays the address of the selected store.-->
    <t t-name="StoreAddress">
        <div id="store_address_section" class="card-body">
            <b>Store Address:</b>
            <span class="address-inline" t-esc="address"/>
        </div>
    </t>
</templates>
