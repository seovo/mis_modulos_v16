<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <field name="email" position="after">
                <field name="email_mercadopago" />
            </field>
       </field>
    </record>

    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Datos Envio Flores" >
                    <group>
                        <group>
                            <field name="date_shipment_florista" />
                            <field name="until_hour_florista" />
                            <field name="number_period_florista" />
                            <field name="interval_period_florista" />
                            <field name="product_terminado_florista" />
                            <field name="next_order_number_list" readonly="1" />
                        </group>
                    </group>
                </page>
            </notebook>
       </field>
    </record>


    <record id="action_until_hour_florista" model="ir.actions.act_window">
            <field name="name">Horas Florista</field>
            <field name="res_model">until.hour.florista</field>
            <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_until_hour_florista" name="Horas Florista"
              parent="sale.menu_sale_config"
              action="action_until_hour_florista"
             />


</odoo>