<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Datos Envio Flores" >
                    <group>
                        <group>
                            <field name="date_shipment_florista" />
                            <field name="number_period_florista" />
                            <field name="interval_period_florista" />
                        </group>
                    </group>
                </page>
            </notebook>
       </field>
    </record>



    <record id="product_normal_form_view" model="ir.ui.view">
           <field name="name">Product.view</field>
           <field name="model">product.product</field>
           <field name="inherit_id" ref="product.product_normal_form_view"/>
           <field name="arch" type="xml">

              <xpath expr="//field[@name='barcode']" position="before">
                  <field name="product_florista_ids">
                      <tree editable="bottom">
                          <field name="sequence" widget="handle"/>
                          <field name="product_terminado_id"  />
                      </tree>
                   </field>


              </xpath>
           </field>
    </record>

</odoo>