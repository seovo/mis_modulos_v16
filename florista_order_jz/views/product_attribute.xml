<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_attribute_view_form" model="ir.ui.view">
           <field name="name">product.attribute.form</field>
           <field name="model">product.attribute</field>
           <field name="inherit_id" ref="product.product_attribute_view_form" />
           <field name="arch" type="xml">

               <xpath expr="//field[@name='create_variant']" position="after" >

                   <field name="is_period_florista"  />
               </xpath>

               <xpath expr="//field[@name='image']" position="after" >
                   <field name="image" class="oe_avatar text-start float-none"

                          options="{'size': [70, 70]}" widget="image"
                   />
                   <!--  column_invisible="parent.display_type != 'color'" -->
               </xpath>

               <xpath expr="//field[@name='value_ids']/tree" position="inside" >
                   <field name="is_period_florista" column_invisible="1"  />
                   <field name="number_period_florista"  invisible="not is_period_florista" optional="show"  />
                   <field name="interval_period_florista"   invisible="not is_period_florista"  optional="show"  />
                   <button name="edit_products" type="object" icon="fa-pencil-square-o"  />
               </xpath>

           </field>
    </record>

    <record id="edit_product_atrv" model="ir.ui.view">
           <field name="name">Pedidos.Form</field>
           <field name="model">product.attribute.value</field>
           <field name="arch" type="xml">
               <form>
                   <sheet>
                       <field name="product_florista_ids"  >
                           <tree  editable="bottom"  >
                               <field name="product_terminado_id" />
                           </tree>
                       </field>

                   </sheet>
               </form>
           </field>
    </record>



</odoo>