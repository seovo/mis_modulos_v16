<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_attribute_view_form" model="ir.ui.view">
           <field name="name">product.attribute.form</field>
           <field name="model">product.attribute</field>
           <field name="inherit_id" ref="product.product_attribute_view_form" />
           <field name="arch" type="xml">
               <xpath expr="//field[@name='image']" position="after" >
                   <field name="image" class="oe_avatar text-start float-none"

                          options="{'size': [70, 70]}" widget="image"
                   />
                   <!--  column_invisible="parent.display_type != 'color'" -->
               </xpath>

               <xpath expr="//field[@name='value_ids']/tree" position="inside" >
                   <field name="is_period_florista" invisible="1"  />
                   <field name="number_period_florista"   invisible="not is_period_florista" />
                   <field name="interval_period_florista"   invisible="not is_period_florista" />
               </xpath>

           </field>
    </record>

    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Fecha Envio Flores" >
                    <group>
                        <group>
                            <field name="date_shipment_florista" />
                        </group>
                    </group>

                </page>
            </notebook>
       </field>
    </record>

</odoo>