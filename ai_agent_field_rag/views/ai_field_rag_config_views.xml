<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_ai_field_rag_config_list" model="ir.ui.view">
        <field name="name">ai.field.rag.config.list</field>
        <field name="model">ai.field.rag.config</field>
        <field name="arch" type="xml">
            <list string="Field RAG Configurations">
                <field name="name"/>
                <field name="agent_id"/>
                <field name="model_id"/>
                <field name="field_id"/>
                <field name="record_count" string="Records"/>
                <field name="source_count" string="Sources"/>
                <field name="indexed_count" string="Indexed"/>
                <field name="last_sync_date"/>
                <button name="action_sync" type="object" string="Sync" icon="fa-refresh" class="btn-link"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_ai_field_rag_config_form" model="ir.ui.view">
        <field name="name">ai.field.rag.config.form</field>
        <field name="model">ai.field.rag.config</field>
        <field name="arch" type="xml">
            <form string="Field RAG Configuration">
                <header>
                    <button name="action_sync" type="object" string="Sync Now" class="btn-primary" icon="fa-refresh"/>
                    <button name="action_view_sources" type="object" string="View Sources" icon="fa-list"/>
                    <button name="action_view_records" type="object" string="View Records" icon="fa-database"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_sources" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <div class="o_stat_info">
                                <span class="o_stat_value">
                                    <field name="indexed_count" widget="integer"/>
                                    /
                                    <field name="source_count" widget="integer"/>
                                </span>
                                <span class="o_stat_text">Indexed Sources</span>
                            </div>
                        </button>
                        <button name="action_view_records" type="object" class="oe_stat_button" icon="fa-database">
                            <div class="o_stat_info">
                                <span class="o_stat_value">
                                    <field name="record_count" widget="integer"/>
                                </span>
                                <span class="o_stat_text">Matching Records</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g., Project Tasks - Descriptions"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Source Configuration">
                            <field name="agent_id" options="{'no_create': True}"/>
                            <field name="model_id" options="{'no_create': True}"/>
                            <field name="model_name" invisible="1"/>
                            <field name="field_id"
                                   domain="[('model_id', '=', model_id), ('ttype', 'in', ['text', 'char', 'html'])]"
                                   options="{'no_create': True}"/>
                            <field name="field_type" invisible="1"/>
                        </group>
                        <group string="Sync Settings">
                            <field name="auto_sync"
                                   help="When enabled, a scheduled action runs hourly to detect new, removed, or changed records and update sources automatically."/>
                            <field name="last_sync_date"/>
                        </group>
                    </group>
                    <group string="Context Fields" name="context_fields">
                        <p class="text-muted small mb-2">
                            These fields are prepended to the main content in the generated source attachment, providing
                            additional context for AI retrieval.
                            Record identifier (type, ID, name) is automatically included for semantic search.
                        </p>
                        <field name="context_field_ids" widget="many2many_tags"
                               domain="[('model_id', '=', model_id), ('name', 'not in', ['name', 'id', 'display_name']), ('ttype', 'in', ['char', 'text', 'selection', 'many2one', 'date', 'datetime', 'integer', 'float', 'boolean'])]"
                               options="{'no_create': True}"
                               nolabel="1"
                               placeholder="e.g., stage_id, user_id, date, priority"/>
                    </group>
                    <group string="Filter Domain" name="filter_domain">
                        <field name="filter_domain" widget="domain"
                               options="{'model': 'model_name', 'in_dialog': True}"
                               nolabel="1"/>
                    </group>
                    <!-- Record count guidance -->
                    <div class="alert alert-success" role="alert" invisible="record_count >= 100">
                        <strong>Good - Focused Dataset</strong>
                        <p class="mb-0">
                            <field name="record_count" readonly="1"/>
                            records match this filter. This is an ideal size for effective RAG retrieval.
                        </p>
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="record_count &lt; 100 or record_count >= 500">
                        <strong>Consider Adding Filters</strong>
                        <p class="mb-0">
                            <field name="record_count" readonly="1"/>
                            records match this filter. Consider adding more specific filters for better retrieval
                            relevance.
                        </p>
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="record_count &lt; 500">
                        <strong>Large Dataset Warning</strong>
                        <p class="mb-0">
                            <field name="record_count" readonly="1"/>
                            records match this filter. Large datasets may reduce retrieval accuracy. Consider narrowing
                            the filter.
                        </p>
                    </div>
                    <div class="alert alert-info" role="alert">
                        <strong>How It Works</strong>
                        <ul class="mb-0">
                            <li>One AI agent source is created per matching record</li>
                            <li>Each source includes: record identifier (type, ID, name) + context fields + main
                                content
                            </li>
                            <li>This structure enables semantic search by record type, ID, name, or context field
                                values
                            </li>
                            <li>Sources are automatically indexed for RAG retrieval by the AI embedding cron</li>
                            <li>When <em>Auto Sync</em> is enabled, an hourly scheduled action detects new, changed, or
                                removed records
                            </li>
                            <li>Use <em>Sync Now</em> to manually trigger an immediate sync
                            </li>
                        </ul>
                    </div>
                    <notebook>
                        <page string="Sources" name="sources">
                            <field name="source_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="status" widget="status_badge_tooltip"
                                           decoration-success="status == 'indexed'"
                                           decoration-info="status == 'processing'"
                                           decoration-danger="status == 'failed'"/>
                                    <field name="is_active"/>
                                    <field name="error_details" column_invisible="True"/> <!-- Required by status_badge_tooltip widget-->
                                    <field name="mimetype" column_invisible="True"/> <!-- Required by agent_source_type_icon widget-->
                                    <field name="user_has_access" column_invisible="True"/> <!-- Required by source_view_link widget-->
                                    <button name="action_access_source" type="object" string="Open"
                                            icon="fa-external-link" class="btn-link"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_ai_field_rag_config" model="ir.actions.act_window">
        <field name="name">Field RAG Configurations</field>
        <field name="res_model">ai.field.rag.config</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a Field RAG Configuration
            </p>
            <p>
                Add content from any model's text, char, or HTML fields as AI agent sources for RAG retrieval.
            </p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_ai_field_rag_config"
              name="Field RAG Configurations"
              parent="ai_app.ai_menu"
              action="action_ai_field_rag_config"
              sequence="36"/>
</odoo>
