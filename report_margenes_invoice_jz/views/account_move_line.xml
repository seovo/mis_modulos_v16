<odoo>
    <record model="ir.ui.view" id="report_margenes" >
        <field name="name">account.move.line.tree</field>
        <field name="model">account.move.line</field>
        <field name="arch" type="xml">
            <tree  edit="0" create="0" delete="0">
                <field name="partner_id"  optional="show" />
                <field name="move_name" string="Factura" optional="hidden"  />
                <field name="ref" optional="hidden" string="Referencia"  />
                <field name="date" optional="show" />

                <field name="always_set_currency_id"  optional="hidden"   />

                <field name="categ_id"    optional="hidden" />
                <field name="product_id"  optional="show" />
                <field name="supplier_disc"  optional="hidden"  />
                <field name="quantity" optional="show"  />
                <field name="price_unit"   optional="hidden"   />
                <field name="standard_price"  optional="hidden"  />

                <field name="acquisition_cost" string="Costo de adquisición"  optional="hidden"   />

                <field name="last_purchase_move_id_jz" optional="hidden" />
                <field name="last_purchase_jz" optional="hidden" />
                <field name="last_purchase_partner_jz" optional="hidden" />
                <field name="last_purchase_paqueteria" optional="hidden" />
                <field name="last_purchase_guia_envio" optional="hidden" />
                <field name="margin_cost_usd_jz" optional="show"  />
                <field name="margin_suggested_usd_jz" optional="show"  />
                <field name="margin_priceunit_usd_jz" optional="show"  />
                <field name="margin_margin_usd_jz" optional="show"   />

                <field name="company_id" optional="show"  />

                <field name="create_uid"   optional="hidden"  />
                <field name="pricelist_id_jz" optional="show"  />





            </tree>
        </field>
    </record>


    <record id="action_account_move_line_tree" model="ir.actions.act_window">
        <field name="name">Reporte Margenes</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">account.move.line</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="report_margenes_invoice_jz.report_margenes" />

        <field name="domain">[('tax_ids','!=',False),('move_id.type','=','out_invoice'),('parent_state','=','posted'),('product_id','!=',False)]</field>
<!--
        <field name="domain">[('move_id.type','=','out_invoice'),('sale_line_ids','!=',False),('parent_state','=','posted'),('product_id','!=',False)]</field>
-->
    </record>

    <menuitem action="action_account_move_line_tree" id="menu_account_move_line_tree"
              parent="account.menu_finance_reports" />
</odoo>
