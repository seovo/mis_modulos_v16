<odoo>
    <record model="ir.ui.view" id="report_margenes" >
        <field name="name">account.move.line.tree</field>
        <field name="model">account.move.line</field>
        <field name="arch" type="xml">
            <tree  edit="0" create="0" delete="0">
                <field name="partner_id"  />
                <field name="move_id" string="'Factura" />
                <field name="always_set_currency_id" />
                <field name="company_currency_id"  optional="hidden"  />
                <field name="product_id"  />
                <field name="supplier_disc"  />
                <field name="quantity"  />
                <field name="price_unit"  />
                <field name="standard_price"  />

                <field name="acquisition_cost" string="Costo de adquisición" />


                <field name="margin_cost_usd_jz"  />
                <field name="margin_suggested_usd_jz"  />
                <field name="margin_priceunit_usd_jz" />
                <field name="margin_margin_usd_jz"  />

                <field name="company_id"  />
                <field name="date"  />
                <field name="create_uid"  />
                <field name="pricelist_id_jz"  />
                <field name="categ_id"  />




            </tree>
        </field>
    </record>


    <record id="action_account_move_line_tree" model="ir.actions.act_window">
        <field name="name">Reporte Margenes</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">account.move.line</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="report_margenes_invoice_jz.report_margenes" />

    </record>

    <menuitem action="action_account_move_line_tree" id="menu_account_move_line_tree"
              parent="account.menu_finance_reports" />
</odoo>