<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vpicktree" model="ir.ui.view">
           <field name="name">stock.picking.tree</field>
           <field name="model">stock.picking</field>
           <field name="inherit_id" ref="stock.vpicktree" />
           <field name="arch" type="xml">



               <xpath expr="//field[@name='json_popover']" position="after" >
                    <field name="quantity_return_jz"  invisible="1" />
                    <button name="return_picking_jz"
                            string="Devolver" type="object" class="oe_highlight"
                             attrs="{'invisible': ['|',('state', '!=', 'done'),('quantity_return_jz','=',0)]}"
                            groups="base.group_user" />

               </xpath>

           </field>
    </record>
</odoo>