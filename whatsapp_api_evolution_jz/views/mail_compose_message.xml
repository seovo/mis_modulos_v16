<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="email_compose_message_wizard_form" model="ir.ui.view">
        <field name="name">mail.compose.message.form</field>
        <field name="model">mail.compose.message</field>
        <field name="inherit_id" ref="mail.email_compose_message_wizard_form" />
        <field name="arch" type="xml">
            <field name="subject" position="after">

                <field name="is_whatsapp_evolution_api" invisible="not subtype_is_log" />
                <field name="number_whatsapp_evolution_api"  invisible="not is_whatsapp_evolution_api or not subtype_is_log" />
                <field name="text_whatsapp_evolution_api" invisible="not is_whatsapp_evolution_api or not subtype_is_log"  />

            </field>

            <field name="body" position="replace">
                <field name="body" class="oe-bordered-editor"
                       invisible="is_whatsapp_evolution_api and  subtype_is_log"
                       placeholder="Write your message here..."
                       options="{'style-inline': true}" readonly="not can_edit_body" force_save="1"/>

            </field>
        </field>
    </record>

</odoo>

